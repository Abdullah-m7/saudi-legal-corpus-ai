{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-companies-law-ar-zh-llm/schemas/book4_provision.schema.json",
  "title": "Saudi Companies Law Book Four Provision (model 1b, thematic)",
  "description": "Book Four uses a THEMATIC provisions data model (model 1b), NOT the per-article model of Books One-Three. A provision record may map to one or more article numbers because the source PDF is a thematic summary. Records are created ONLY for provisions explicitly rendered in the source; uncovered articles get no record (tracked instead in the coverage matrix as needs_official_text_check).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book", "provision_id", "source_article_numbers", "thematic_section",
    "provision_title_ar", "provision_title_zh", "arabic_reference_summary",
    "chinese_translation", "translation_mode", "risk_flags", "source", "llm"
  ],
  "properties": {
    "book": {"const": 4},
    "provision_id": {"type": "string", "pattern": "^sa-companies-book4-prov[0-9]{3}$"},
    "source_article_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 58, "maximum": 137},
      "description": "One or more Book Four article numbers this provision maps to."
    },
    "thematic_section": {
      "type": "string",
      "enum": [
        "formation_and_capital",
        "board_and_governance",
        "general_assemblies",
        "shares_debt_and_financing",
        "finance_profits_and_capital_changes"
      ]
    },
    "provision_title_ar": {"type": "string", "minLength": 1},
    "provision_title_zh": {"type": "string", "minLength": 1},
    "arabic_reference_summary": {"type": "string", "minLength": 1},
    "chinese_translation": {"type": "string", "minLength": 1},
    "translation_mode": {"type": "string", "enum": ["internally_reviewed_summary"]},
    "coverage_status": {
      "type": "string",
      "enum": ["covered", "expanded_after_review", "needs_official_text_check"]
    },
    "legal_notes": {"type": "array", "items": {"type": "string"}},
    "terminology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ar", "zh"],
        "properties": {"ar": {"type": "string"}, "zh": {"type": "string"}}
      }
    },
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_pdf", "official_text_check", "source_coverage_status"],
      "properties": {
        "input_pdf": {"type": "string", "const": "inputs/bab4_source.pdf"},
        "page_hint": {"type": ["integer", "null"]},
        "official_text_check": {"type": "string", "enum": ["checked", "needs_check"]},
        "source_coverage_status": {"type": "string", "enum": ["explicit_in_source"]}
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "retrieval_title", "keywords_ar", "keywords_zh", "summary_en"],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^sa-companies-book4-prov[0-9]{3}$"},
        "retrieval_title": {"type": "string", "minLength": 1},
        "keywords_ar": {"type": "array", "items": {"type": "string"}},
        "keywords_zh": {"type": "array", "items": {"type": "string"}},
        "summary_en": {"type": "string"}
      }
    }
  }
}
