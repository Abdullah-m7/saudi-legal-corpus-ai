{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-companies-law-ar-zh-llm/schemas/arabic_legal_llm.schema.json",
  "title": "Arabic Legal LLM-ready record",
  "description": "Structured Arabic legal-understanding layer over the corpus. Supports BOTH per-article records (Books 1-3) and thematic provision records (Book Four model 1b). This layer is metadata built ON TOP of internally-reviewed reference summaries/provisions; it does NOT replace official statutory text and is not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book", "record_type", "record_id", "article_numbers",
    "legal_subject_ar", "legal_rule_summary_ar", "legal_basis_type",
    "actors_ar", "rights_ar", "obligations_ar", "prohibitions_ar",
    "conditions_ar", "exceptions_ar", "legal_effects_ar", "liability_ar",
    "monetary_thresholds", "deadlines_ar", "competent_authorities_ar",
    "cross_references_ar", "keywords_ar", "search_queries_ar",
    "risk_flags", "source_trust"
  ],
  "properties": {
    "book": {"type": "integer", "minimum": 1},
    "record_type": {"type": "string", "enum": ["article", "provision"]},
    "record_id": {"type": "string", "minLength": 1},
    "article_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1, "maximum": 200},
      "description": "One article for per-article records; one or more for Book Four provisions."
    },
    "legal_subject_ar": {"type": "string", "minLength": 1},
    "legal_rule_summary_ar": {"type": "string", "minLength": 1},
    "legal_basis_type": {
      "type": "string",
      "enum": ["mandatory", "default", "permissive", "prohibition", "definition", "procedural", "mixed"],
      "description": "Nature of the rule: آمر / مكمِّل / مبيح / حظر / تعريف / إجرائي / مختلط."
    },
    "actors_ar": {"type": "array", "items": {"type": "string"}},
    "rights_ar": {"type": "array", "items": {"type": "string"}},
    "obligations_ar": {"type": "array", "items": {"type": "string"}},
    "prohibitions_ar": {"type": "array", "items": {"type": "string"}},
    "conditions_ar": {"type": "array", "items": {"type": "string"}},
    "exceptions_ar": {"type": "array", "items": {"type": "string"}},
    "legal_effects_ar": {"type": "array", "items": {"type": "string"}},
    "liability_ar": {"type": "array", "items": {"type": "string"}},
    "monetary_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount", "currency", "description_ar"],
        "properties": {
          "amount": {"type": "number"},
          "currency": {"type": "string"},
          "description_ar": {"type": "string"}
        }
      }
    },
    "deadlines_ar": {"type": "array", "items": {"type": "string"}},
    "competent_authorities_ar": {"type": "array", "items": {"type": "string"}},
    "cross_references_ar": {"type": "array", "items": {"type": "string"}},
    "keywords_ar": {"type": "array", "items": {"type": "string"}},
    "search_queries_ar": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "source_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_text_check", "text_type", "notes"],
      "properties": {
        "official_text_check": {"type": "string", "enum": ["checked", "needs_check"]},
        "text_type": {
          "type": "string",
          "enum": ["internally_reviewed_summary", "internally_reviewed_provision"],
          "description": "Underlying text is an internally-reviewed reference summary/provision, NOT official text."
        },
        "notes": {"type": "string"}
      }
    }
  }
}
