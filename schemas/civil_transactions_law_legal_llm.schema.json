{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-legal-corpus-ai/schemas/civil_transactions_law_legal_llm.schema.json",
  "title": "Saudi Civil Transactions Law Arabic LLM-ready record",
  "description": "LLM/RAG retrieval layer over the owner-provided official Arabic text of the Civil Transactions Law (721 articles, Royal Decree M/191, 1444H). Carries the verbatim article text plus mechanical retrieval metadata only (ordinal titles; term-frequency keywords; structural section context). No summary, paraphrase, translation, or legal interpretation. Arabic is governing. Not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "law_id", "law_component", "article_number", "article_key", "article_title_ar",
    "record_id", "record_type", "language", "governing_text_language",
    "section_context_ar", "article_text_ar", "article_text_hash_sha256",
    "llm_title_ar", "retrieval_title_ar", "article_path", "keywords_ar",
    "search_queries_ar", "text_status", "source_trust",
    "translation_performed", "legal_interpretation_performed",
    "english_used_for_correction", "text_summarized_or_paraphrased"
  ],
  "properties": {
    "law_id": {"type": "string", "const": "sa-civil-transactions-law-m191-1444"},
    "law_component": {"type": "string", "const": "law"},
    "article_number": {"type": "integer", "minimum": 1, "maximum": 721},
    "article_key": {"type": "string", "pattern": "^civil_law_art_[0-9]{3}$"},
    "article_title_ar": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "pattern": "^civil-law-llm-art-[0-9]{3}$"},
    "record_type": {"type": "string", "const": "official_arabic_article"},
    "language": {"type": "string", "const": "ar"},
    "governing_text_language": {"type": "string", "const": "ar"},
    "section_context_ar": {"type": "string"},
    "article_text_ar": {"type": "string", "minLength": 1},
    "article_text_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "llm_title_ar": {"type": "string", "minLength": 1},
    "retrieval_title_ar": {"type": "string", "minLength": 1},
    "article_path": {"type": "string", "pattern": "^civil/law/articles/[0-9]{3}$"},
    "keywords_ar": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "search_queries_ar": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "text_status": {"type": "string", "const": "OWNER_PROVIDED_CROSS_CHECKED_MOJ_PORTAL"},
    "source_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority", "source_authority_ar", "source_status", "source_document_ar", "royal_decree"],
      "properties": {
        "source_authority": {"type": "string", "minLength": 1},
        "source_authority_ar": {"type": "string", "minLength": 1},
        "source_status": {"type": "string", "const": "owner_provided_official_text"},
        "source_document_ar": {"type": "string", "minLength": 1},
        "royal_decree": {"type": "string", "minLength": 1}
      }
    },
    "translation_performed": {"type": "boolean", "const": false},
    "legal_interpretation_performed": {"type": "boolean", "const": false},
    "english_used_for_correction": {"type": "boolean", "const": false},
    "text_summarized_or_paraphrased": {"type": "boolean", "const": false}
  }
}
