{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-companies-law-ar-zh-llm/schemas/coverage.schema.json",
  "title": "Book One Coverage Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage_id", "book", "articles_range", "rows"],
  "properties": {
    "coverage_id": {"type": "string"},
    "book": {"type": "integer", "minimum": 1},
    "scope_ar": {"type": "string"},
    "scope_zh": {"type": "string"},
    "articles_range": {"type": "string"},
    "total_articles": {"type": "integer"},
    "expanded_after_review": {"type": "array", "items": {"type": "integer"}},
    "columns": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_number", "article_title_ar", "article_title_zh", "coverage_status", "expression_mode", "note"],
        "properties": {
          "article_number": {"type": "integer", "minimum": 1, "maximum": 200},
          "article_title_ar": {"type": "string"},
          "article_title_zh": {"type": "string"},
          "coverage_status": {"type": "string", "enum": ["covered", "expanded_after_review", "needs_official_text_check"]},
          "expression_mode": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
