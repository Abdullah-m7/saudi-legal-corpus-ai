{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-companies-law-ar-zh-llm/schemas/glossary.schema.json",
  "title": "Arabic-Chinese Legal Glossary",
  "type": "object",
  "additionalProperties": false,
  "required": ["glossary_id", "terms"],
  "properties": {
    "glossary_id": {"type": "string"},
    "description_en": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["topic"],
        "properties": {"topic": {"type": "string"}}
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ar", "zh"],
        "properties": {
          "ar": {"type": "string", "minLength": 1},
          "zh": {"type": "string", "minLength": 1},
          "pinyin": {"type": "string"},
          "domain": {"type": "string"}
        }
      }
    }
  }
}
