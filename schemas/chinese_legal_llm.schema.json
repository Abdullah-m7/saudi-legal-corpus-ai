{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-companies-law-ar-zh-llm/schemas/chinese_legal_llm.schema.json",
  "title": "Chinese Legal LLM-ready record",
  "description": "Structured Chinese legal-understanding layer built ON TOP of the existing internal Chinese provision text. The core text `legal_rule_text_zh` is copied VERBATIM from the corresponding Book Four provision's `chinese_translation` field — it is NOT a new/machine translation and NOT a model-generated summary. The Chinese is an INTERNAL WORKING TRANSLATION / LLM-ready metadata only; the governing/binding text is the Arabic original. This layer is not an official translation and is not legal advice. `additionalProperties` is false, so no generated-summary field (e.g. `legal_rule_summary_zh`) may appear.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book", "record_type", "record_id", "article_numbers",
    "legal_subject_zh", "legal_rule_text_zh", "legal_basis_type",
    "actors_zh", "rights_zh", "obligations_zh", "prohibitions_zh",
    "conditions_zh", "exceptions_zh", "legal_effects_zh", "liability_zh",
    "monetary_thresholds", "deadlines_zh", "competent_authorities_zh",
    "cross_references_zh", "keywords_zh", "search_queries_zh",
    "risk_flags", "source_trust"
  ],
  "properties": {
    "book": {"type": "integer", "minimum": 1},
    "record_type": {
      "type": "string",
      "enum": ["article_reference"],
      "description": "This layer references the existing internal Chinese provision text per article group; it is not statutory text."
    },
    "record_id": {"type": "string", "minLength": 1},
    "article_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1, "maximum": 200},
      "description": "One or more article numbers this record references."
    },
    "legal_subject_zh": {"type": "string", "minLength": 1},
    "legal_rule_text_zh": {
      "type": "string",
      "minLength": 1,
      "description": "VERBATIM copy of the corresponding provision's `chinese_translation`. Not a new/machine translation and not a model-generated summary."
    },
    "legal_basis_type": {
      "type": "string",
      "enum": ["mandatory", "default", "permissive", "prohibition", "definition", "procedural", "mixed"]
    },
    "actors_zh": {"type": "array", "items": {"type": "string"}},
    "rights_zh": {"type": "array", "items": {"type": "string"}},
    "obligations_zh": {"type": "array", "items": {"type": "string"}},
    "prohibitions_zh": {"type": "array", "items": {"type": "string"}},
    "conditions_zh": {"type": "array", "items": {"type": "string"}},
    "exceptions_zh": {"type": "array", "items": {"type": "string"}},
    "legal_effects_zh": {"type": "array", "items": {"type": "string"}},
    "liability_zh": {"type": "array", "items": {"type": "string"}},
    "monetary_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount", "currency", "description_zh"],
        "properties": {
          "amount": {"type": "number"},
          "currency": {"type": "string"},
          "description_zh": {"type": "string"}
        }
      }
    },
    "deadlines_zh": {"type": "array", "items": {"type": "string"}},
    "competent_authorities_zh": {"type": "array", "items": {"type": "string"}},
    "cross_references_zh": {"type": "array", "items": {"type": "string"}},
    "keywords_zh": {"type": "array", "items": {"type": "string"}},
    "search_queries_zh": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "source_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chinese_source_status", "governing_text_language", "official_text_check",
        "manual_review_status", "source_reference_file", "notes"
      ],
      "properties": {
        "chinese_source_status": {
          "type": "string",
          "enum": ["internal_working_translation"]
        },
        "governing_text_language": {"type": "string", "enum": ["ar"]},
        "official_text_check": {"type": "string", "enum": ["needs_check"]},
        "manual_review_status": {"type": "string", "enum": ["needs_manual_check"]},
        "source_reference_file": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
