{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/al3obdi/saudi-legal-corpus-ai/schemas/investment_regulation_legal_llm.schema.json",
  "title": "Saudi Investment Regulations Arabic LLM-ready record",
  "description": "LLM/RAG retrieval layer over the verified Arabic text of the Investment Law Implementing Regulations (37 articles), from the official MISA Arabic PDF. Carries the verified article text plus mechanical retrieval metadata only. No summary, paraphrase, translation, or legal interpretation. Arabic is governing. Not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "law_id", "law_component", "article_number", "article_key", "article_title_ar",
    "record_id", "record_type", "language", "governing_text_language",
    "article_text_ar", "article_text_hash_sha256", "llm_title_ar", "retrieval_title_ar",
    "article_path", "keywords_ar", "search_queries_ar", "text_status", "source_trust",
    "translation_performed", "legal_interpretation_performed",
    "english_used_for_correction", "text_summarized_or_paraphrased"
  ],
  "properties": {
    "law_id": {"type": "string", "const": "sa-investment-law-1446"},
    "law_component": {"type": "string", "const": "implementing_regulation"},
    "article_number": {"type": "integer", "minimum": 1, "maximum": 37},
    "article_key": {"type": "string", "pattern": "^investment_reg_art_0(0[1-9]|[1-2][0-9]|3[0-7])$"},
    "article_title_ar": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "pattern": "^inv-reg-llm-art-0(0[1-9]|[1-2][0-9]|3[0-7])$"},
    "record_type": {"type": "string", "const": "verified_arabic_article"},
    "language": {"type": "string", "const": "ar"},
    "governing_text_language": {"type": "string", "const": "ar"},
    "article_text_ar": {"type": "string", "minLength": 1},
    "article_text_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "llm_title_ar": {"type": "string", "minLength": 1},
    "retrieval_title_ar": {"type": "string", "minLength": 1},
    "article_path": {"type": "string", "pattern": "^investment/regulation/articles/0(0[1-9]|[1-2][0-9]|3[0-7])$"},
    "keywords_ar": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "search_queries_ar": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "text_status": {"type": "string", "const": "VERIFIED_TRANSCRIBED_FROM_OFFICIAL_MISA_PDF"},
    "source_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority", "source_authority_ar", "source_status", "source_document_ar", "source_pdf_sha256"],
      "properties": {
        "source_authority": {"type": "string", "minLength": 1},
        "source_authority_ar": {"type": "string", "minLength": 1},
        "source_status": {"type": "string", "const": "verified_transcribed_from_official_misa_pdf"},
        "source_document_ar": {"type": "string", "minLength": 1},
        "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "translation_performed": {"type": "boolean", "const": false},
    "legal_interpretation_performed": {"type": "boolean", "const": false},
    "english_used_for_correction": {"type": "boolean", "const": false},
    "text_summarized_or_paraphrased": {"type": "boolean", "const": false}
  }
}
