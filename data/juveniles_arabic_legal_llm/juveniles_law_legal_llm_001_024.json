   "is_mukarrar": false,
   "article_key": "juveniles_art_008",
   "article_title_ar": "المادة الثامنة",
   "section_ar": "",
   "legal_status_ar": "اصلية",
   "is_repealed": false,
   "is_amended": false,
   "is_added": false,
