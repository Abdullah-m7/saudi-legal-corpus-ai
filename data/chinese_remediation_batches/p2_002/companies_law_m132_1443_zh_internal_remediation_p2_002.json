    {
      "article_number": 113,
      "bab": 4,
      "article_title_ar": "الإلزام ببيع الأسهم",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "050ebf8f90580fee667aea5e8fdd4dd894862adef821af26bdde0bd7ed4191b5",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "5240d53d6cb29bf4e01cf4d912f7ec22da98bd2344c8fd72aa2759c7b45c1c3e",
      "prior_candidate_record_id": "zh-int-companies-art-113",
      "prior_candidate_hash_sha256": "01b67cca18f463054dfa7de58b00465f6c5ab1d4d3baf0395b8234aa0ba3e6f3",
      "backlog_priority": "P2",
      "backlog_remediation_track": "P2_expansion_needed",
      "backlog_current_blocker": "condensed_translation_needs_expansion",
      "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
      "remediated_chinese_text": "在不违反《资本市场法》的前提下，经至少代表公司有表决权股份百分之九十（90%）的股东同意，公司基本章程可规定下列事项：\n（一）多数股东有权强制少数股东接受善意买方按与购买多数股东股份相同的价格、条款和条件收购公司全部股份的要约。\n（二）在多数股东出售其股份的情形下，少数股东有权强制多数股东保证按与出售多数股东股份相同的价格、条款和条件一并出售少数股东的股份。",
      "remediated_chinese_text_hash_sha256": "ac5e70d3abe1dd080db8eb654352c8c3f2ffa5c016d7c904fdf2d8af5c3556c9",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
