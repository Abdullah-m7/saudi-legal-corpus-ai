    {
      "article_number": 66,
      "bab": 4,
      "article_title_ar": "تقييم الحصص العينية",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "20a7cda912ed00aef6e9712066e06c4a9707e1259a7c0160e956e6817189f02f",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "0e2a35f0167e853ea8fee37f4522d7540349eebde56ea169f5e27434f4601a1b",
      "prior_candidate_record_id": "zh-int-companies-art-066",
      "prior_candidate_hash_sha256": "080183ba8e230dc8e661a9afb6f434fa07e0f0b8c2c335ebdc1f3530e53f085a",
      "backlog_priority": "P2",
      "backlog_remediation_track": "P2_expansion_needed",
      "backlog_current_blocker": "condensed_translation_needs_expansion",
      "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
      "remediated_chinese_text": "若在公司设立时或增资时提供实物出资，应由一名或多名认证评估师对该出资进行评估，评估师应编制报告载明该出资的公允价值，并视情况提交创始人或非常股东大会审议；实物出资人不得就针对其出资所编制的报告的决议参与表决；若创始人或股东大会决定下调为实物出资所确定的对价，须取得该出资人对该项下调的同意。\n自认证评估师就实物出资公允价值出具评估报告之日起，至就该出资发行股份之日止，其间隔期限不得超过法规所定的期限。",
      "remediated_chinese_text_hash_sha256": "8eee19569191983b65d05f56dc3a92616ff2b25fb8d3ba2a4d7e3d24f3052c93",
      "internal_reference_only": true,
