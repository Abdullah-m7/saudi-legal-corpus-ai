    {
      "article_number": 75,
      "bab": 4,
      "article_title_ar": "بيع أصول الشركة",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "b6ab38050ffd7d674e6d3577778166358c298d64b47ce7eb909c0e38725a54f0",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "e12d068539a4f0a2405fc3c2d7c6b343e128713285b55b1873e2f612d2b52e36",
      "prior_candidate_record_id": "zh-int-companies-art-075",
      "prior_candidate_hash_sha256": "fa4e95e983a5097f594e6c9523359a67032118ed3a53c15375e038568626343e",
      "backlog_priority": "P2",
      "backlog_remediation_track": "P2_expansion_needed",
      "backlog_current_blocker": "condensed_translation_needs_expansion",
      "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
      "remediated_chinese_text": "出售公司资产其价值超过公司总资产价值百分之五十（50%）时，无论通过一笔交易或多笔交易进行，董事会均须取得股东大会的批准；在此情形下，导致资产价值超过百分之五十（50%）的该笔交易即为须经股东大会批准的交易，该比例自此前十二（12）个月内完成的第一笔交易之日起计算；主管机关可将某些行为和处分排除于本条规定的适用之外。",
      "remediated_chinese_text_hash_sha256": "e5f14f7a0a4d1f7ccf8fd2ee8a5b707150131c344a5c12501b4de309cea65486",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "source_basis": "official_arabic_plus_existing_chinese_candidate",
