      "english_guidance_hash_sha256": "e74f73d1d40eefb3d20e07ea9b71309e0d473605143ae40a42e27ceef013661e",
      "prior_candidate_record_id": "zh-int-companies-art-060",
      "prior_candidate_hash_sha256": "888f22574b8ee8c055eb59b3dfe4aa3bf3a09e38ba38057b067b8695f73f6bc1",
