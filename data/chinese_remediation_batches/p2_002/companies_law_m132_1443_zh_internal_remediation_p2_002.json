    {
      "article_number": 115,
      "bab": 4,
      "article_title_ar": "التخلف عن الدفع",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "3dbc3d8e5a90d9bf118cda8b815c8e742996b6434b5a39cd6392568bea7f7284",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "a2b9cd9cc247490e9958730e5b3fddbbf77f7885aa25f83645056a44fadf9781",
      "prior_candidate_record_id": "zh-int-companies-art-115",
      "prior_candidate_hash_sha256": "9e151de6a0cc4f8f7170bcb3dbff5b25db4ec10f6db926a6ff84f727cf5b4fa8",
      "backlog_priority": "P2",
      "backlog_remediation_track": "P2_expansion_needed",
      "backlog_current_blocker": "condensed_translation_needs_expansion",
      "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
      "remediated_chinese_text": "股东应在规定的期限内缴付股份价值的剩余部分；若其未在规定期限内履行，董事会在依公司基本章程规定的方式通知该股东、或以挂号信、或通过任何现代技术手段告知该股东后，可视情况在公开拍卖或资本市场出售该股份；公司基本章程可规定其他股东对购买违约股东的股份享有优先权。\n公司从出售所得中受偿其应得的款项，并将余额返还股份持有人；若出售所得不足以清偿该等款项，公司可从该股东的全部财产中受偿其余额。\n与未按规定期限缴付价值的股份相关的权利，自该期限届满时起至依本条第（一）款出售该股份或缴清其应付款项时止，暂停生效，该等权利包括获得已决定分配的净利润份额的权利、以及出席股东大会并对其决议进行表决的权利；但违约股东在出售之日前仍可缴付其应付的价值并加付公司为此支出的费用，在此情形下该股东有权请求获得已决定分配的利润。\n公司依本条规定注销所售股份的股票，并向买受人发给一份载有相同编号的新股票，同时在股东名册中批注该项出售并载入新持有人的必要资料。",
      "remediated_chinese_text_hash_sha256": "83c131d6d08ca536962e5df5657b8f4be3956fa2a7fa31a1e2b9de6d3580a242",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "source_basis": "official_arabic_plus_existing_chinese_candidate",
