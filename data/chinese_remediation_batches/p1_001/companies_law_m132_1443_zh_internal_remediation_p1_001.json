   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 5,
   "bab": 1,
   "article_title_ar": "اسم الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "39d45e7d2e1b75618952e03edfc26e1f67d7ef995a9dc0f988ee0163caf8f186",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "e994f3b27493d896ceba798f496347cdd9e99e1443ad334209481850fdb0c68a",
   "prior_candidate_record_id": "zh-int-companies-art-005",
   "prior_candidate_hash_sha256": "ee1b8220675a24f69eedc0116a34df017930eff72f4cf791f05c7f7a7033b23f",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "每一公司应有以阿拉伯语或其他语言表示的商号名称；该名称可以取自其经营目的，或为具有显著性的名称，或为其现任或前任一名或多名合伙人或股东的姓名，或为上述各项的组合，但须注意不得违反商号名称法以及王国现行的其他法律法规。\n如商号名称含有公司前合伙人或股东的任何姓名，须取得该合伙人或股东的同意；若其已故且生前未表示同意，则须取得其继承人的同意。\n商号名称应附有表明公司形式的字样。\n公司的商号名称可依照修改公司设立合同或章程所规定的方式予以变更；该变更不影响公司在变更前所享有的权利、承担的义务，或其已采取或已被采取的法定程序。",
   "remediated_chinese_text_hash_sha256": "622e258153852b4095fd2a41415c74e68198834370b31cca8038c33417058efc",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 6,
   "bab": 1,
   "article_title_ar": "طلب تأسيس الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2cc67c7b824343a8ba878b567206226358e4d3bdb5ede48dda66965812c277d8",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "43797fb391ec6ad1e04725eb97c341dd656260a5783c0e8a455ab74619468c9a",
   "prior_candidate_record_id": "zh-int-companies-art-006",
   "prior_candidate_hash_sha256": "260ca3874253c2966940cf274fb99c6c96517981829e3a46bbc806a604cf26ef",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "凡实际参与公司设立并以现金或实物出资认缴公司资本者，均视为发起人。\n发起人应向商业登记机关提交公司的设立及登记申请，并随附设立合同或章程，以及依公司形式所需的资料和文件。\n商业登记机关应就资料和文件齐备的申请，依照本法规定作出决定。\n拒绝申请的，应说明理由；发起人有权自被告知拒绝之日起（六十）日内向部提出申诉。\n申诉被拒绝、或自提出之日起（三十）日内未获决定的，发起人有权向主管司法机关提出申诉。",
   "remediated_chinese_text_hash_sha256": "e6095e6fb66fad7cf888931afbedd286002ab08aac9dd2775a7b3ef401a8a5d4",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
