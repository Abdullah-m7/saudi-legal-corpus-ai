   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 3,
   "bab": 1,
   "article_title_ar": "جنسية الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "42a8944cf60f240fac299ceae483704d61e77788723d7b8492dace5b16dd6ad0",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "521f0fb2750a97aa39650796febaf95550961fdedc821bb4e70df986af3a2097",
   "prior_candidate_record_id": "zh-int-companies-art-003",
   "prior_candidate_hash_sha256": "c7531fd24a8eb0b65faa8edb95bd437b8dfda7997dd4ef538493d3b825dcb541",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "依照本法规定设立的公司具有沙特国籍，其主要中心（总部）应设在王国境内。",
   "remediated_chinese_text_hash_sha256": "30e6a06f081c8e2d9aeef0121001acf130dca2dc56217ef74ed56077c8084951",
   "internal_reference_only": true,
