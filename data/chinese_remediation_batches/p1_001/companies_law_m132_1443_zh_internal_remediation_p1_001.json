  {
   "article_number": 2,
   "bab": 1,
   "article_title_ar": "تعريف الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "df97175196a9240cb35c886d82a285b2b47b632150a688f69c8961fc98a38f42",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "c1fe1c485cba530cdf0a0680f3d28cbea075c17a1beaf9f627ed7b8f9afe7a23",
   "prior_candidate_record_id": "zh-int-companies-art-002",
   "prior_candidate_hash_sha256": "fabdd9137ea29adea6d270286c0364610507847074f350662b4b31649de01c32",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司是依照本法规定、基于设立合同或章程而设立的法律实体；据此，两人或两人以上各自承诺以提供资金出资、劳务出资或两者兼有的方式，参与一项以营利为目的的项目，以分享该项目所产生的利润或亏损。作为例外，依照本法规定，公司可由一人以单方意思表示设立；并可依照本法第（七）编的规定设立非营利公司。",
   "remediated_chinese_text_hash_sha256": "f4ba9485a814e57fbcf87164b04a7b21210c963828eb1bfbe166dbc48c4ae502",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
