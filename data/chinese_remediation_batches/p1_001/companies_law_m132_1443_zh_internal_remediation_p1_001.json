  {
   "article_number": 11,
   "bab": 1,
   "article_title_ar": "اتفاق الشركاء والميثاق العائلي",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "bd8af4c827ae01698979742f07ce01d1736a547f19632bc8208215b6f30eb9a5",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "8d80ecc4cc12949bbe9743d37bad5d04df952f2ebdeb6e6953c01f5d6ac183d2",
   "prior_candidate_record_id": "zh-int-companies-art-011",
   "prior_candidate_hash_sha256": "edeb93c1c40f966d6d98a481c117911c06d4459fa816706e2519f86f9083e0c9",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "发起人、合伙人或股东，无论在公司设立期间或其后，均可进行下列事项：\n- （一）订立一项或多项协议，规范彼此之间或与公司之间的关系，包括其继承人以本人身份或通过为此目的设立的公司加入本公司的方式。\n- （二）订立家族宪章，就公司中家族所有权及其治理、管理、经营政策、家族成员雇佣政策、利润分配、出资或股份的处分，以及争议或分歧的解决机制等事项作出规定。\n该协议或家族宪章具有约束力，并可作为公司设立合同或章程的一部分；但以不违反本法、或公司设立合同或章程为条件。",
   "remediated_chinese_text_hash_sha256": "d0b933ece9f6e1318ac290a5c0a5c8c717493b1e4170abda31fd15315bd4cc91",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
