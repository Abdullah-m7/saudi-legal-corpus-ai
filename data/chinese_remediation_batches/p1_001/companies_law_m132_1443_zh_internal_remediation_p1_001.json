   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 7,
   "bab": 1,
   "article_title_ar": "وثائق تأسيس الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "0e2965ba7b8b0c8873dc3fba71209c790af137c6a3d73a7124982a953759a315",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "b36d48282e5cabe2f7fde4fcf6d82355f1137504a49edcb619d44898264b0c18",
   "prior_candidate_record_id": "zh-int-companies-art-007",
   "prior_candidate_hash_sha256": "f49a2ec53b1bddc9420f57b20c024dabd7b1477f3e04b26d5ff3bc5886bf8669",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "依照本法规定设立的每一公司应有设立合同，但股份公司、简易股份公司及一人所有的有限责任公司除外，此三者各应有章程。\n公司设立合同或章程应载明本法所要求的、并与公司形式相适应的各项规定、条件和资料。\n公司设立合同或章程应以阿拉伯语作成，并可附有其他语言的译文。\n部应编制与公司形式相适应的公司设立合同及章程的指导性范本。",
   "remediated_chinese_text_hash_sha256": "ee9f44d3654773e2457aac291de1d50520622fa526dd8dc52fa65be9f987f0bb",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
