  {
   "article_number": 9,
   "bab": 1,
   "article_title_ar": "اكتساب الشخصية الاعتبارية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "059563a9f6f2bd7d4d2a4647956544d2ac8625ac8a33b2dd4fa038af8244dfb1",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "bc96d3d50016079e7332402bf7a3e0dc041d0b851eeeed6381953acd17d44aec",
   "prior_candidate_record_id": "zh-int-companies-art-009",
   "prior_candidate_hash_sha256": "38d2d05ac62105a1b0da27b6808cddbc99187d7358c78c6b784546922751b8a6",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司自在商业登记机关登记后取得法人资格；但在设立期间，公司在其设立所必需的限度内具有法人资格，条件是设立程序得以完成。\n公司在商业登记机关登记后，发起人为公司利益所订立的一切合同及所进行的一切行为均转移至公司名下，公司并承担发起人为设立公司所支出的一切费用。\n若公司设立程序未按本法规定完成，则以公司名义或为公司利益进行交易或行为的人员，应就其在设立期间所作出的行为和处分，以其全部财产对第三人承担个人及连带责任。",
   "remediated_chinese_text_hash_sha256": "4e82a154882698ce72f90914ef5d75396eab74e9e621faa37f26bb9e3220ff5f",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
