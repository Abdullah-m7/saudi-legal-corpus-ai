  },
  {
   "article_number": 8,
   "bab": 1,
   "article_title_ar": "قيد وثائق تأسيس الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "71febfa1b2170fe8da478950140a959e78cf168137829575ec4a8bf39850fef5",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "e649b744814c05d9fb4dd9c4a585df3252ed98247bb49bcbacc9441cea635a44",
   "prior_candidate_record_id": "zh-int-companies-art-008",
   "prior_candidate_hash_sha256": "5677ee870a2f7b02e53d15c87f15fde0e697717839559c6353ecac6db0b4d2a4",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司设立合同或章程及其任何修改，均应以书面作成，否则该合同、章程或修改无效；公司的设立、或其设立合同或章程的修改，应在依照本法及实施条例的规定完成必要要求后，方为有效。\n发起人、合伙人、公司经理或董事会成员（视情形而定）应将公司设立合同或章程及其修改在商业登记机关登记；商业登记机关应依照本法及实施条例的规定公示必要的资料或文件。上述人员中导致文件未在商业登记机关登记者，应就公司、合伙人、股东或第三人因未登记而遭受的损害承担连带赔偿责任。\n第三人可查阅本条第（二）款所规定的资料和文件；自商业登记机关调取的资料和文件，对公司及第三人具有对抗效力。\n公司设立合同、章程或其任何修改，非经在商业登记机关登记，不得对抗第三人；若一项或多项资料未予登记，则仅该未登记事项不对第三人生效。",
   "remediated_chinese_text_hash_sha256": "4ca10d27ce2ba47a1ff9d337b30c01e14c921f7a3b341861a02202cb3ed2a03c",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
