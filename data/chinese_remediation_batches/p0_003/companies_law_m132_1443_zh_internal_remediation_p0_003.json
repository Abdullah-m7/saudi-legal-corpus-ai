      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 118,
      "bab": 4,
      "article_title_ar": "تحويل أدوات الدين والصكوك التمويلية",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "bbc6663a44ccece7dd19fa32c839089a042202eb8c74106aeeb84733fc17cff6",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "1483c05474a87a4fa92e46db0c89a9218f9dc1fd2d79a709fa6808f6015dd86d",
      "remediated_chinese_text": "公司可以依照资本市场法，经债务工具或融资凭证持有人同意，将债务工具或融资凭证转换为股份；该同意可以是事先同意（例如作为发行条件的一部分），也可以是事后约定。",
      "remediated_chinese_text_hash_sha256": "b8682a0571cd4a75786b09f5bb8221eda3565475e46d8cbcfa43a5aba7e44f21",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 119,
      "bab": 4,
      "article_title_ar": "التعويض عن الضرر",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "218b198d0d6578d96052e16b9d85f2483bab75a78318806a7085d91dadb39159",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "7f55bb30a49fdf75a6daca8cffbeb3ce02d88617db293d353d1f795ee31dbcbd",
      "remediated_chinese_text": "任何利害关系人均可请求主管司法机关，宣告违反本法第一百一十七条或第一百一十八条规定所作的行为无效，并请求就债务工具或融资凭证持有人所受的损害予以赔偿。",
      "remediated_chinese_text_hash_sha256": "7aad98eb29102ea288158f874d8f281f9fbde49ab9c0f38279d77e7ee19cff37",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 120,
      "bab": 4,
      "article_title_ar": "سريان قرارات جمعيات المساهمين",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "ff6ef9112508e5a4440821336bb6b5651070b5b3557187ca7a477f0ae725ab65",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "f41497716207478adfc183f60d9f5d8b30a3cfd0c81e5ea664523ce520994e94",
      "remediated_chinese_text": "股东大会的决议对债务工具和融资凭证持有人适用。但是，除非经该等持有人在依照本法第八十九条规定召开的、由其组成的专门会议上作出同意，股东大会不得修改为其确定的权利。",
      "remediated_chinese_text_hash_sha256": "b8beac734a8dd9b09f26311c9f3992f1b10bfe64ad87144d2eca449739b4e479",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 121,
      "bab": 4,
      "article_title_ar": "القوائم المالية وتقرير عن نشاط الشركة",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "696f8ef762f0017be1d9d4f0c86a4bedd369a4b75890d41845673d125ec64ad2",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "3ff6f9a5bc2d6f0aa166b31d06a88bb0e6cf5e983b28aab052a610e094dc3cb6",
      "remediated_chinese_text": "董事会应当在公司每一会计年度结束时，编制公司的财务报表以及关于已结束会计年度公司活动和财务状况的报告，该报告应当载明所建议的利润分配方式。董事会应当在为普通股东大会年度会议确定的日期之前至少（四十五）日，将该等文件提供给审计师（如有）。\n本条第（1）款所指文件应当由公司董事长、首席执行官及首席财务官（如有）签署，其副本应当存放于公司主要营业地，供股东查阅。",
      "remediated_chinese_text_hash_sha256": "339ba1337a81da8abb7bca3bdf98a301298dce1a2875d943449d28ff2c17d984",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 122,
      "bab": 4,
      "article_title_ar": "تزويد المساهمين بالقوائم المالية وإيداعها",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "93768a56e6c920f28c3a21131922ba2d44db84188ab892a3996f8f51d9ab57f1",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "4af8df92d67be8041fec240d2b96d790b46bb3a3d6fb660f8ffaf66f4faf80ba",
      "remediated_chinese_text": "董事长应当在为普通股东大会年度会议确定的日期之前至少（二十一）日，向股东提供已签署的公司财务报表和董事会报告，以及审计师报告（如有），但已通过任何现代技术手段公布者除外；董事长还应当依照实施条例的规定存放该等文件。",
      "remediated_chinese_text_hash_sha256": "b9d27b4c1459e08d0de405f40c6850e11f6356f633335ddfbfee79734ef8ea0b",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 123,
      "bab": 4,
      "article_title_ar": "تكوين الاحتياطيات",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "290bb6cfe3d3b95084ab37951de9aee21df0582317040416e5f8d5a625e2694a",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "dc3518528ec3d1f840317350dfe30c1ca4f388e7db1864f4c43f0ae703ae7832",
      "remediated_chinese_text": "公司章程可以规定从净利润中提留一定比例，以设立用于公司章程所定用途的储备金。主管机关可以制定设立储备金的规则。\n普通股东大会在确定股份于净利润中的份额时，可以决定设立其他储备金，其数额以实现公司利益、或尽可能确保向股东分配固定利润为限。该股东大会亦可以从净利润中提取款项，用于实现有利于公司员工的社会目的。",
      "remediated_chinese_text_hash_sha256": "14575694d5ba7f19a90193fd09c2ba7105d29740f59737438ad3add84eb91d65",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 124,
      "bab": 4,
      "article_title_ar": "استخدام الاحتياطيات",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "3c300991efd6f98939f683f6acb35e25584d50e85c585f6c1c23a1ba34270ac7",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "fbb3beb3425820ef59c0836383497267cae6e08e2ab4ff51d6270f8037b398e7",
      "remediated_chinese_text": "为公司章程所定特定用途而设立的储备金，非经特别股东大会决议，不得使用。该储备金未指定特定用途的，普通股东大会可以根据董事会的建议，决定将其用于有利于公司或股东的事项。主管机关可以制定使用储备金的规则。\n普通股东大会可以使用留存收益和可分配储备金，缴付股份价值的剩余部分或其一部分，但不得依照本法的规定损害股东之间的公平。",
      "remediated_chinese_text_hash_sha256": "32dd0ed30d0d8e011ecc7aebcbdaab347b7e32cff8d576cd5634e6e95c4680ca",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
