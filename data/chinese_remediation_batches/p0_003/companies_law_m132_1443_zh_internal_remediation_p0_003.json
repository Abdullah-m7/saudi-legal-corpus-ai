  "records": [
    {
      "article_number": 111,
      "bab": 4,
      "article_title_ar": "قيود تداول الأسهم",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "5bbcad4bae129c7db1fb3685c35b81fec5064b22dd0679d12ff5fd63f1b572f3",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "1813b649ce0977f5234d8ec9209eaa4fbdb8a49d84b53d58f6d3bbd3e3e8d0be",
      "remediated_chinese_text": "资本市场管理局可以就拟在资本市场上市其股份的股份公司的股份交易设定限制。\n公司章程可以就股份交易设定限制，包括为股东规定请求赎回股份的权利；但在任何情形下，该等限制不得导致对该交易的绝对禁止。",
      "remediated_chinese_text_hash_sha256": "a84531015b045e7042524be7a0e321ae1f2ed672f124ba6e29ab75abe2e9d7b7",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 112,
      "bab": 4,
      "article_title_ar": "سجل المساهمين",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "dd26b2fbe89fea1f92f995a5925804fa3eebafdfff1b81d983c8148ad8b73492",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "dca6a59089776ed3a1af4c738e5cd0f0d403e560b26f1e36dd56c22affc0498b",
      "remediated_chinese_text": "未在资本市场上市的股份公司，应当编制一份专门簿册，载明股东的姓名、国籍、资料、居所和职业，各股东所持股份的数量、股份编号及其已缴付的数额；公司可以委托他人编制该簿册，且该簿册必须保存于王国境内。\n公司应当在其于商业登记机关登记之日起、或（视情况）在发生变更之日起（十五）日内，将本条第（1）款所指簿册的数据及其任何变更提供给商业登记机关。",
      "remediated_chinese_text_hash_sha256": "b66e4006add3cf9e874e628a426641e383fb539984d3d8f9f22624cc998812c6",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 114,
      "bab": 4,
      "article_title_ar": "شراء الأسهم وارتهانها ورهنها",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "ba95c5c00e02494fbf58b7ffdd2f02e775a931aa9b7860da441b6e0e48da7562",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "67b13520e78f873360eaedf203e4cc4e162bc561710015a7558f186c9daf718c",
      "remediated_chinese_text": "公司章程有规定的，公司可以购买其自身股份或接受其作为质押；公司所购买的股份在股东大会中无表决权。\n股份可以质押；除质押合同另有约定外，质权人可以收取利润并行使与股份相关的权利。质权人不得出席股东大会会议，也不得在其中表决。\n实施条例确定执行本条规定所需的规则。",
      "remediated_chinese_text_hash_sha256": "72c1c1cbe0d40fd1fe7b7a91139b95d42f816f02f13d0ceffa394eaf772e2e6f",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 116,
      "bab": 4,
      "article_title_ar": "المطالبة بدفع ما يزيد على ما التزم به المساهم",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "e85da3b4673c271ef667d7980cde701e688d653ea576a39507ff83724f4f0a35",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "21edf8df5b4ede58e439f1d6dd9086b5d10e4a8ca1a2c6fa5fc3b09bc24d1c50",
      "remediated_chinese_text": "公司不得要求股东缴付超过其在股份发行时所承担数额的款项，即使公司章程有规定亦然。",
      "remediated_chinese_text_hash_sha256": "797f6ad58863a12b82b5acb1326264f3981904d5d8180deaf43610216e80bb82",
      "internal_reference_only": true,
