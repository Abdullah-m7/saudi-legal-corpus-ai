  {
   "article_number": 157,
   "bab": 6,
   "article_title_ar": "الشركة ذات المسؤولية المحدودة من شخص واحد",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "a56e2e425cf7a2df7583b19beb65f1ceb039c4a352756c6c7120b5268eb336f5",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "e31739b23cd324b05d2d89e122feb51d4ee7121b845791e880337c99b8c1ea39",
   "prior_candidate_record_id": "zh-int-companies-art-157",
   "prior_candidate_hash_sha256": "3046875eefdc68960acdb7c8daa80d2a600d08c35245274ac22ebed2c4be9668",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在有限责任公司由一人设立、或其全部出资额归于一人时，产生下列后果：\n（一）该人拥有本编所规定的公司经理、经理会及股东大会的权限和权力，其决定以书面作出，并登录于公司的专门登记簿。\n（二）该人可以任命一名或多名经理，由其作为公司在司法机关、仲裁机构和第三人面前的代表，并就公司管理向持有公司出资额的股东负责。\n一人所有的有限责任公司应有章程。适用于有限责任公司的规定中凡提及设立合同者，均指公司章程。",
   "remediated_chinese_text_hash_sha256": "1184e6a68fa318141fbd1442b993d573d2432d396774806ff6187f53b7b8419f",
   "internal_reference_only": true,
