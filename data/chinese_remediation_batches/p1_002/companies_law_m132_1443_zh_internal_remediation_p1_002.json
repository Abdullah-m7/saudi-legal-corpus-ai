   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 90,
   "bab": 4,
   "article_title_ar": "الجمعيات العامة والخاصة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "7ae78c5c362bb674893da4e80ea5c2a79b75bd7db88734954410936bf5026204",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "1acb52624a50a346f235860a0db9597517c7f905ebd09c4a769af2bc362a3ce8",
   "prior_candidate_record_id": "zh-int-companies-art-090",
   "prior_candidate_hash_sha256": "6fc8b11758cacfea108ef45d36694b2e721411293cf26e872dcff1abd4acda80",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "普通股东大会和特别股东大会由董事会召集，依照公司章程规定的方式召开。董事会应在审计师、或代表公司至少（百分之十）具表决权股份的一名或多名股东提出请求之日起（三十）日内，召集普通股东大会召开；若董事会未在审计师提出请求之日起（三十）日内发出召集，审计师可以召集普通股东大会召开。\n本条第（一）款所述请求应载明要求股东表决的事项。\n主管机关可以经决定在下列情形召集普通股东大会召开：\n（一）本法第（八十八）条第（一）款所定普通股东大会召开的期限届满而未召开的。\n（二）经查明存在违反本法或公司章程的情形、或公司管理出现失当，包括董事会成员人数低于其有效召开所需的最低人数的。\n（三）董事会在本条第（一）款所定期限内、自审计师或代表公司至少（百分之十）具表决权股份的一名或多名股东提出请求之日起未发出召集普通股东大会的。\n主管机关可以采取召开普通股东大会的必要措施，并在依照本法第（八十四）条第（一）款无法主持该大会会议时主持之。",
   "remediated_chinese_text_hash_sha256": "b9c567f68b3179f3edbbc7c7278e4e404d05803aa50aefa14e818f16fe94b2bb",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
