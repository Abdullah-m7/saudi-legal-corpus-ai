  {
   "article_number": 132,
   "bab": 4,
   "article_title_ar": "خسائر الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "04dcf0022d6c52a72a5e065a5a46dce68b9e6ea7762915ab4d263ba2a19dad98",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "cb0be705d21e4ebe35ca21fd2a955809b085f9216b0d315afb1cceef7ce2eecb",
   "prior_candidate_record_id": "zh-int-companies-art-132",
   "prior_candidate_hash_sha256": "6dfc43bc4c022331f9300b6d7ad0fe22585783c6ba6bb326856713d440d1e910",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "若股份公司的亏损达到已发行资本的（二分之一），董事会应自其知悉亏损达到该数额之日起（六十）日内，披露该情况及其就该等亏损提出的建议，并自知悉之日起（一百八十）日内召集特别股东大会开会，以审议公司是否继续经营并采取处理该等亏损的任何必要措施，或将公司解散。",
   "remediated_chinese_text_hash_sha256": "9e61dd0d1cbe6d3866eb6cca73a53789a6e2e7cbb0430c61cd99d753291cd156",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
