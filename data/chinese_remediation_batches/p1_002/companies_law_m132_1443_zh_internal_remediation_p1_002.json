  {
   "article_number": 149,
   "bab": 5,
   "article_title_ar": "إصدار القرار بالتمرير",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "465337bb4c810186ed58f372173b6a8b4195ea0d9bd2bb844ed45d1987d8013a",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "95b31b2824a85154d59e090ca1af0cf8e62c71bbf9816601d74825c4f4953bfc",
   "prior_candidate_record_id": "zh-int-companies-art-149",
   "prior_candidate_hash_sha256": "762b82055bc40827fd071e81e3f2a8f4e3dfc75dedb2503b1f293bc23e9a5f3d",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司章程可以规定股东决议通过以传阅方式提交股东作出，而无需其召开会议。在此情形下，公司董事长、经理或董事会（视情形而定），将拟议决议及与之相关的文件发送给全体股东，并说明股东为表示同意应遵循的方式及决议应作出的日期。\n除公司章程规定其他通知方式外，拟议决议及与之相关的文件可以通过下列任一方式发送：\n（一）以挂号信发送给股东。\n（二）亲自送交股东或其法定代理人。\n（三）通过电子邮件或任何现代技术手段发送。\n公司章程应确定以传阅方式有效作出股东决议所需的法定人数。",
   "remediated_chinese_text_hash_sha256": "0af4f259499eb08b9fbe7f6c6f3359b6d887c1c1072f8d5e51dca515f32f4894",
