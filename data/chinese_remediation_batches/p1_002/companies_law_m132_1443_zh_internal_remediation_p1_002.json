  {
   "article_number": 108,
   "bab": 4,
   "article_title_ar": "أنواع الأسهم وفئاتها",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "70f43c8b4f6508afd6e134638f6c84ce52adf5d2a505518e4d877899c61b2951",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "6e4a07ac4c032db191e3fc4f95fe07eb8878ed75a447389bf560b42cfe4024cf",
   "prior_candidate_record_id": "zh-int-companies-art-108",
   "prior_candidate_hash_sha256": "b970d2608f16a0b090327a0b1c06b30600247893914a18d75e72551e7b8ace9c",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司可以发行的股份类型分为：普通股、优先股和可赎回股。公司章程可以规定不同的股份类别，并对其中某些类别授予某些权利或特权、或设定某些限制。\n同一类型或类别的股份赋予相等的权利和义务；每一类型或类别的股份依照公司章程享有与其相关的权利。\n实施条例应确定可以发行的股份类型和类别的规则。",
   "remediated_chinese_text_hash_sha256": "f06c560ca7787b1873b6cd2a974c103c13ada38c7fcffdc895dacec8cb514a24",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
