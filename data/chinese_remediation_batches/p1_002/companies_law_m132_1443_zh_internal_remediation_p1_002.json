  {
   "article_number": 164,
   "bab": 6,
   "article_title_ar": "عزل المدير",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "00c105f7a8d6b1a9ff73e7899c98fd39bce0ce77174efee4a7fec80aefe378cd",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "a62ca5f48928be13216108e97cab19b6eade3354eeaa224371d2f9a194ab719c",
