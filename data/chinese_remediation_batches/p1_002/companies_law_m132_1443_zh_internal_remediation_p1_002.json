  {
   "article_number": 117,
   "bab": 4,
   "article_title_ar": "إصدار أدوات الدين والصكوك التمويلية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2ee1eca347e1c7638590d9043af06cf5ad18620fa993e5cd7e3ec8c54e9dfd19",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "2b19d6c4721c9793c205a54bd273c9c6de313edd2910226487adfffe1fa84b09",
   "prior_candidate_record_id": "zh-int-companies-art-117",
   "prior_candidate_hash_sha256": "5ba30fb7d2a1ff094dc3653a023d2309f3b89ba532be92900a7899e9186e54f7",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "股份公司可以依照资本市场法发行可交易的债务工具或融资凭证（苏库克）。\n公司发行可转换为股份的债务工具或融资凭证，须经特别股东大会作出决议，其中载明可就该等工具或凭证发行的股份最高数量，无论该等工具或凭证是一次性发行、通过一系列发行、还是通过一项或多项发行计划发行。董事会无需该大会重新批准，即可在该等工具或凭证的持有人于其规定的转换请求期届满时请求转换、或在其自动转换为股份的条件成就时、或在规定的转换期届满时，就其发行新股份，并采取必要措施就已发行股份数量和资本修改公司章程。\n董事会应就每次增资程序的完成在商业登记机关办理登记。",
   "remediated_chinese_text_hash_sha256": "ef448f7244ea99930ef7d2a3a20d90f7cbf86c9efae3dd2ad0fcf86218a03548",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
