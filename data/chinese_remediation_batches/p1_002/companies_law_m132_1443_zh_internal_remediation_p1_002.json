  {
   "article_number": 165,
   "bab": 6,
   "article_title_ar": "الجمعية العامة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "e7af38856805e4fe7c5722fe900c7eb089bf643bf190515ead5d60eeb36ccb9d",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "2df4ac63a14107c30091de5a5e87d342f96e4b091d60798b5d83eb0843a68838",
   "prior_candidate_record_id": "zh-int-companies-art-165",
   "prior_candidate_hash_sha256": "cfdd6fb6ef9fbaa3634aeadde63c121063b4b1f8ed74126df65e0a0766aaacdd",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "有限责任公司应有由全体股东组成的股东大会。\n股东大会由经理依照公司设立合同确定的方式召集，且每年至少在公司财政年度结束后的（六）个月内召开一次。\n经经理、审计师、或代表资本至少（百分之十）的一名或多名股东请求，可以随时召集股东大会。召集通知应以挂号信、现代技术手段、或设立合同规定的任何其他方式，至少在股东大会确定的召开日期前（二十一）日发送给全体股东。\n代表公司全部出资额的股东，可以不受召集所定方式和期限的限制召开股东大会。\n股东大会的审议及其决议、或股东以传阅方式作出的决议，应记入公司为此目的设立的专门登记簿中的会议记录。公司可以使用现代技术手段证明和记录审议与决议。\n股东大会会议的召开、以及股东参与审议和对决议的表决，可以通过现代技术手段进行。",
   "remediated_chinese_text_hash_sha256": "d14eb3839e30786fae77f1f16ba51136aba309fb0ef6cebcc58aad82515398d4",
