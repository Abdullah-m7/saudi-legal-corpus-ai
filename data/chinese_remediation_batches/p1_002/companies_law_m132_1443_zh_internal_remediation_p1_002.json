  {
   "article_number": 72,
   "bab": 4,
   "article_title_ar": "تقديم القروض",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "52c479d36bc3fbb41b0d7e7a780f42ae5f68e1b6ad0791221e7ea2459e9c8d00",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "550148aacada09f1b9b5e26647f7726cf7cdae7d47867d79fc612d7c3baeed00",
   "prior_candidate_record_id": "zh-int-companies-art-072",
   "prior_candidate_hash_sha256": "62e0d0c05324b1ff2ed3c57760417844576a4cddad086940b89d4cb07772074c",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "股份公司不得向其任何董事会成员提供任何类型的贷款，也不得就其任何成员与第三人订立的贷款订立任何担保或提供任何保证。上述规定同样适用于向其任何亲属提供的任何贷款、担保或保证。任何违反该规定订立的合同均属无效。公司有权就其可能遭受的损害向主管司法机关请求违反者赔偿。\n本条第（一）款的规定不适用于下列情形：\n（一）银行及其他融资公司：在其经营目的范围内、并按其与公众交易所遵循的方式和条件，可以向其某一董事会成员提供贷款、为其开立信贷额度，或就其与第三人订立的贷款为其提供担保。\n（二）公司依照其章程规定或股东大会决议批准的员工激励计划所给予的贷款和担保。\n主管机关可以确定公司不得向其任何股东提供贷款、或提供与贷款相关担保的情形和规则。",
   "remediated_chinese_text_hash_sha256": "beb99cfcceee3e38b4723a88a8a1ca72db806903c09cb423230cde9558875299",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 77,
   "bab": 4,
   "article_title_ar": "صلاحيات مجلس الإدارة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2c8261de3ecbfc105059241dc97d49be3950afcff99650a638c82e8a8e522003",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "bf21d97355e8b837eb6120d9bdd6e5d00d7f932ec44cfa0c507785c9a67c6954",
   "prior_candidate_record_id": "zh-int-companies-art-077",
   "prior_candidate_hash_sha256": "bc9eaf8167f5e3dfbe2e1e9ff0caee1d4d5d64e15c7277605771ead09db9d0eb",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在不影响股东大会法定职权的前提下，董事会在管理公司以实现其目的方面拥有最广泛的权力，但本法或公司章程以专门条文列为属于股东大会职权范围的业务或行为除外。董事会亦可在其职权范围内，委托其一名或多名成员或第三人执行某项或某些特定业务。\n公司须受董事会以其名义所进行的一切业务和行为的约束，即使超出其职权范围，除非与之交易者出于恶意、或明知该等业务超出董事会的职权范围。",
   "remediated_chinese_text_hash_sha256": "b2d392f6bcf52ff1670ac7adc61f6a88d0469aa44fad75895785cec5e0c1f74d",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
