   "prior_candidate_hash_sha256": "ae902fc6a6e27435b09c8a3ec37049de7e161d1f4afaa8f23102884dc77b7251",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "股东可以罢免经理，无论其是在公司设立合同中还是在独立合同中被任命；股东应任命一名或多名经理接替被罢免者。若经理为公司股东，则其不得参与就罢免自己的决议进行表决。\n代表公司资本至少（四分之一）的一名或多名股东，可以向主管司法机关提出罢免经理的请求。",
   "remediated_chinese_text_hash_sha256": "14ac6ae583b823efc204662ca014b9b920b1266926fd31eda4875f1e6d22d8f1",
   "internal_reference_only": true,
