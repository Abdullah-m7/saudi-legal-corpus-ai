    {
      "article_number": 190,
      "bab": 7,
      "article_title_ar": "انتهاء العضوية في الشركة",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "14d2d2e25cdf7dae855df67095b50ea0c5246eb2f3582b59d45cd426987c96ac",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "8422d43caa9903277b1a2d989a884b10b5845377ceed0c9e2111654730259569",
      "remediated_chinese_text": "在遵守本法以及非营利公司设立合同或章程规定的前提下，非营利公司的成员资格在下列情形下终止：\n（一）死亡，或法人资格消灭。\n（二）在私营非营利公司中将成员资格转让给他人。\n（三）依照公司设立合同或章程的规定予以取消。\n（四）成员资格期限届满而未续展。\n（五）公司终止。",
      "remediated_chinese_text_hash_sha256": "82b3a076e2dec78131c3a984ff7ae31b800a5e1f31ef5f496404338442dacd82",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
      "translation_basis": "official_arabic_governing_text",
      "english_guidance_role": "secondary_guidance_only",
      "source_status_before": "excluded_no_isolable_article_text",
      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 191,
      "bab": 7,
      "article_title_ar": "طلب إنهاء العضوية",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "f8381db074a5c0f31ba1c63fe8c151653918284194cf970239c222b054905009",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "de598499542bb7630274b88e182bcfef6e6529d40694af5b41f95feb91cc30b6",
      "remediated_chinese_text": "成员可以请求终止其成员资格，但如该终止导致其对公司义务的违反，则应当就此赔偿公司。",
      "remediated_chinese_text_hash_sha256": "30fd8d369685a542c96c68be712f138df52a5bc9a6614ee9395b5feef06a454e",
      "internal_reference_only": true,
