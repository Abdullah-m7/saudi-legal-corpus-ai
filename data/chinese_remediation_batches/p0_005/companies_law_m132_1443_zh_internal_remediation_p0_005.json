      "remediation_action": "create_new_internal_chinese_translation_from_arabic",
      "qa_status": "pending_future_qa"
    },
    {
      "article_number": 189,
      "bab": 7,
      "article_title_ar": "حقوق العضو والتزاماته",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "7545f4bcb7f7297557bc7b7c1bfc5d7cf1d55265b6ab4d9bf82a38aa924ad857",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "8b8df7be2211f48efe73b362122754d26859f795eb525a234f5267a87300f593",
      "remediated_chinese_text": "各成员资格类别具有平等的权利和义务；成员享有与其成员资格相关的一切权利，包括参与成员大会审议的权利，以及查阅公司记录和文件的权利。",
      "remediated_chinese_text_hash_sha256": "524d37c574f97ce6526840b163f417361cfa3da9cc328fa8d8c51088d43d5ff2",
      "internal_reference_only": true,
