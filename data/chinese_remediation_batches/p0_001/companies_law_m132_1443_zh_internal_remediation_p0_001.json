      "language": "zh",
      "governing_text_language": "ar",
      "remediated_chinese_text": "股份公司由董事会管理，董事会成员人数不得少于（三）名。\n每一股东均有权提名其本人、他人，或一名以上的股东或非股东，参选股份公司董事会成员。",
      "remediated_chinese_text_hash_sha256": "fde0ae93577a96bf6e5a3ffe1ce0e9a2f4141d02e936868f713978fbf032f1f7",
      "arabic_source_hash_sha256": "a32bc21759f8d2c28e3eeb1991b8de00d74f8a8031da09474a99efdcf3f3d708",
      "english_guidance_hash_sha256": "41f224fab4b7a134e9e4b67a898abb01c057ba4af7333c0e3d2618199c6462bb",
