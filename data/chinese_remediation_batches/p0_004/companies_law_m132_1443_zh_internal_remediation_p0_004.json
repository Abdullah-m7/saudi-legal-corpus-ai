      "bab": 6,
      "article_title_ar": "تعيين مدير الشركة",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "d4e58d4dd35b4f38c9256a5ca6dd10f7991276d0a0cce5497e10f01dcfd522f1",
