    {
      "article_number": 148,
      "bab": 5,
      "article_title_ar": "محاضر اجتماعات المساهمين",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "700b3af1af37108ebaa4128a70ecc444d8e8fb3fc1bc79af2737171c4b44a5d5",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "86d9033acbd278cefbf68f18914ef5a29cf063930fbf4dbed6a5fe2265053fe4",
      "remediated_chinese_text": "股东会议的审议和决议、或以书面传阅方式作出的决议，应当作成会议记录，记入由公司总裁、经理或董事会（视情况）签署的专门簿册。公司可以使用现代技术手段来证明和记录该等审议和决议。\n公司总裁、经理或董事会（视情况）应当在实施条例规定登记的股东决议作出之日起（十五）日内，将其在商业登记机关登记。",
      "remediated_chinese_text_hash_sha256": "84706e9287bf16f9ea06b8c06f5c8a03ea7a6d1b443c82dab6b8ee6f8b57a8b9",
