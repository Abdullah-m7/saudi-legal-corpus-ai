    {
      "article_number": 136,
      "bab": 4,
      "article_title_ar": "المساواة بين المساهمين",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "2ef09fb9d4c102ba0a5864f8177a5fadd2d51673d6d6b420a804139fc7e28938",
