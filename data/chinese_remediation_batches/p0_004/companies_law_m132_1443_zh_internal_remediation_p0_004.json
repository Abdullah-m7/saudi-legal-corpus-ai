    {
      "article_number": 161,
      "bab": 6,
      "article_title_ar": "طريقة إدارة الشركة",
      "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
      "arabic_source_hash_sha256": "fa653ade0cb3195e115a1f75c2cdbf72fc69bbe9579e0ee059f02935f611f34c",
      "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
      "english_guidance_hash_sha256": "f347c6b923dd0459a1e2a7f3e3c0398ef1f4b41f7d5cf3042afa6ff929c5b4b4",
      "remediated_chinese_text": "任命多名经理或组成经理会的，公司设立合同或合伙人决议确定公司的管理方式，以及作出决议所需的多数。",
      "remediated_chinese_text_hash_sha256": "32e6e414cd75690db63439453640049d74286c8f974b99818db6a5928d40a664",
      "internal_reference_only": true,
      "official_chinese_translation_claimed": false,
      "chinese_binding_claimed": false,
      "chinese_governing_claimed": false,
      "human_legal_review_status": "pending_human_legal_review",
