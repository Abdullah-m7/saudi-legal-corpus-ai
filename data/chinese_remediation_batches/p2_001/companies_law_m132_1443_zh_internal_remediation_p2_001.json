   "bab": 1,
   "article_title_ar": "نصيب الشريك بالعمل في الربح والخسارة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "b1b935240699528ad331bad0f6d2ab8025617c02192615196661c9686657bf4b",
