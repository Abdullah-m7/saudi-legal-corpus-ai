  {
   "article_number": 30,
   "bab": 1,
   "article_title_ar": "عدم سماع الدعوى",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "dc52162f629c469ef84b173e78c20c69028273a8a1a1873883b247a7fc4551c7",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "a8efc3df72cb877ec954bdc7af866bb599e31002d169fcca597f38f7eb16c302",
   "prior_candidate_record_id": "zh-int-companies-art-030",
   "prior_candidate_hash_sha256": "b27a870abff28693c41da34fc4eba172ab48b15eb4450b05142865b34a4d0a1e",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "合伙人、股东大会或股东（视情形而定）同意免除经理或董事会成员的责任，不妨碍依照本法第（二十九）条提起诉讼。\n除伪造和欺诈两种情形外，责任之诉在损害行为发生所在公司财政年度结束之日起满（五）年、或有关经理任职或成员在董事会任期结束之日起满（三）年（以较晚者为准）后不予受理。",
   "remediated_chinese_text_hash_sha256": "d4b7d395124861cda6cf27b6e3ba1ede04f078d56a4f96dc0affceacb57d65e9",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
