  {
   "article_number": 27,
   "bab": 1,
   "article_title_ar": "تعارض المصالح والمنافسة واستغلال الأصول",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "bcfcb9d308c4d5b842f8cb2ecee3193d452d0bc289a3cae620599eebac4eef5e",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "583e1ae29d99e663a41825c03715472ca1671208f3b344fc794c7aa6ffe90e2d",
   "prior_candidate_record_id": "zh-int-companies-art-027",
   "prior_candidate_hash_sha256": "da45c339c6a734b2f385f850d35498b60a3ff6903207876a5adf9d45a2cea3ab",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "除经合伙人、股东大会、股东或其授权者许可外，公司经理或其董事会成员不得在为公司利益进行的业务和合同中拥有任何直接或间接利益。\n除经合伙人、股东大会、股东或其授权者许可外，公司经理或其董事会成员不得参与任何可能与公司竞争的业务、或在公司所经营活动的任一分支领域与公司竞争。\n公司经理或其董事会成员，不得利用公司资产、公司信息、或因其经理或董事会成员身份而向其提供的、或向公司提供的投资机会，为自己谋取直接或间接利益。\n实施条例确定执行本条第（一）款、第（二）款和第（三）款所需的规则。\n本条第（一）款的规定不适用于下列情形：\n（一）依照公开竞争（招标）进行的业务和合同。\n（二）旨在满足个人需求的业务和合同，条件是其按公司与一般交易者和缔约者所遵循的相同方式和条件进行、且属于公司通常活动的范围。\n（三）实施条例在不与公司利益相抵触的前提下所确定的任何其他业务或合同。\n若公司经理或其董事会成员违反本条第（一）款，公司有权向主管司法机关请求撤销该合同，并责令其交出由此取得的任何利润或利益。\n若公司经理或其董事会成员违反本条第（二）款，公司有权向主管司法机关请求适当的赔偿。",
   "remediated_chinese_text_hash_sha256": "bbc11c292e284eb983dc6e707e48189e53acf6849eb70bd0a89100c28183efe5",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_arabic_plus_existing_chinese_candidate",
