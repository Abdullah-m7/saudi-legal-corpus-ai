  {
   "article_number": 22,
   "bab": 1,
   "article_title_ar": "توزيع الأرباح",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "f7d6c610e7adcec1735ac71e27521078b822f626b859d7c0b015daa5aa4132b3",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "44fc7dabc8f53ff93bb950f66409154c9c976774e8b187b0cdfe5e458b4b7bd2",
   "prior_candidate_record_id": "zh-int-companies-art-022",
   "prior_candidate_hash_sha256": "41e108f633350fcc93e3f52460b89ac1779d4ca7abd666f2ec757579980011f3",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "可以从可分配利润中，向股份公司、简易股份公司和有限责任公司的合伙人或股东分配年度利润或中期利润。\n若违反本条第（一）款的规定向合伙人或股东分配利润，则公司债权人可以向公司请求，公司可以向每一合伙人或股东（即使其为善意）请求返还其所领取者。\n合伙人或股东对依照本条第（一）款规定向其分配的利润不负返还义务，即使公司在其后各期发生亏损。\n实施条例确定执行本条规定所需的规则。",
   "remediated_chinese_text_hash_sha256": "2c713de3eb8db411efc88063d986bd42451cc93e7897aab36cef93ad12f6f79b",
   "internal_reference_only": true,
