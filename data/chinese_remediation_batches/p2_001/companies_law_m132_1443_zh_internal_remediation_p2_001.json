  {
   "article_number": 32,
   "bab": 1,
   "article_title_ar": "نفقات إقامة دعوى المسؤولية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "0667920eb3f1a394e9abea345cd53412ec65e3d31d2cf9779e1a615dd21af1f0",
