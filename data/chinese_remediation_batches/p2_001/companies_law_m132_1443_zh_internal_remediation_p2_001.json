  {
   "article_number": 26,
   "bab": 1,
   "article_title_ar": "واجبات العناية والولاء",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "6177f93efb7bcd8a251192c1a3eee630380e39dacb7ce0027de9440c1b7f9b45",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "f74b3d280361d3002b0206e3f5e771d7cf7ea3b5344105590c79c812f8324e68",
   "prior_candidate_record_id": "zh-int-companies-art-026",
   "prior_candidate_hash_sha256": "57fd9f47b2254987612888a4043d89d17076eab5411978ec6f1c3b1e682493fa",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "公司经理或其董事会成员应遵守注意义务和忠实义务，特别是下列各项：\n（一）在为其确定的权限范围内履行其职务。\n（二）为公司利益行事并促进其成功。\n（三）独立作出决策或对其进行表决。\n（四）尽到合理且可预期的注意、关注、审慎和技能。\n（五）避免利益冲突情形。\n（六）披露其在为公司利益进行的业务和合同中拥有的任何直接或间接利益。\n（七）不接受第三人给予的、与其在公司职务有关的任何利益。\n实施条例确定与本条相关的专门规定。",
   "remediated_chinese_text_hash_sha256": "541341e6217f06cc78be76c95107eff8373421303d877e4e1f425eae46bba7c2",
   "internal_reference_only": true,
