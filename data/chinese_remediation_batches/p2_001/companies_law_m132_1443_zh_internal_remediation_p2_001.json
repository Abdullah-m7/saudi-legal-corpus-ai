   "bab": 1,
   "article_title_ar": "تقاسم الأرباح والخسائر",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "0f3bea402dad78c55bdc6870cb5ae6305a0457d01226440acba176106a9631ee",
