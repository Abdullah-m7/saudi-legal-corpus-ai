  {
   "article_number": 31,
   "bab": 1,
   "article_title_ar": "قاعدة تقييم القرارات",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "28195e8f7912becc07f73f1ef14f6752fca977ef0193c348b71984c7652af5b9",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "8e64cb5aebd0494a9dad2624f268ed054dc406f27708aed56092669ce0e1ce72",
   "prior_candidate_record_id": "zh-int-companies-art-031",
   "prior_candidate_hash_sha256": "deb9def353388874e470dfd2d46a45b05aa987a6cd14fd9afbd6229859bd064e",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "在下列情形实现时，公司经理或其董事会成员在其以善意所作出或表决的决议中视为已履行其义务：\n（一）其在决议事项中不拥有利益。\n（二）其按其合理认知，在周围情况下对决议事项作了适当程度的了解和掌握。\n（三）其确信并合理地认为该决议实现公司利益。\n证明相反情况的举证责任由起诉人承担。就本条而言，决议指就与公司业务相关事项的作为或不作为。",
   "remediated_chinese_text_hash_sha256": "da1936b7b11e917497dcf5c4edd2a265c33c011cf0a9a59215e8dca0e27e725b",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
