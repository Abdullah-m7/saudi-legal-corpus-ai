  {
   "article_number": 28,
   "bab": 1,
   "article_title_ar": "مسؤولية الإدارة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2021448904f9ae5b33bc58e33e8a2bdec0033dbd5f763b556c4238aa113916c0",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "44a1176f1a06374fec8b4cf09c7aa46eaba72774f1a8c7c0ec5c2c9811f9e444",
   "prior_candidate_record_id": "zh-int-companies-art-028",
   "prior_candidate_hash_sha256": "6b6557bb69048fc03dd2c16b07de1ab2d90f7ae199b066d0f369697d8a17e33e",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "经理和董事会成员对因违反本法、公司设立合同或基本章程的规定、或因其在履行职务中发生的错误、疏忽或懈怠所产生的损害，向公司、合伙人、股东或第三人负连带赔偿责任。任何相反的约定均视为自始不存在。\n责任或为个人责任、由某一经理或成员本人承担，或在决议经全体一致作出时由全体经理或全体董事会成员共同承担；若决议以多数意见作出，则持反对意见的经理或成员在其于会议记录中明确表示反对时不负责任。缺席作出该决议的会议不构成免除责任的理由，除非证明缺席的经理或成员不知悉该决议、或在知悉后无法对其提出反对。\n公司可以在其经理或董事会成员任职或任期内，为其因其身份而产生的任何责任或索赔提供保险保障。",
   "remediated_chinese_text_hash_sha256": "10fb3272d712ef81fe9e77809417651cf4d108ed1da410c5454a1b5ab4831d0a",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_arabic_plus_existing_chinese_candidate",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "condensed_candidate_needs_expansion",
   "remediation_action": "expand_existing_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 29,
   "bab": 1,
   "article_title_ar": "دعوى الشركة والشريك أو المساهم",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "ef658f9a62f97bf172bb9ce60a4816db4622f77a1dd6dac122882bb82357ee45",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "f895f6ad4302bb545e552f34f5b0e145a56e5b21480ca0382b329d8a05409d18",
   "prior_candidate_record_id": "zh-int-companies-art-029",
   "prior_candidate_hash_sha256": "6554044624749bf8bbc37d746dc67ce019d879f62a7a56a96993e1e7b55645e6",
   "backlog_priority": "P2",
   "backlog_remediation_track": "P2_expansion_needed",
   "backlog_current_blocker": "condensed_translation_needs_expansion",
   "backlog_remediation_action": "expand_existing_internal_chinese_from_arabic",
   "remediated_chinese_text": "公司可以就经理或董事会成员违反本法、公司设立合同或基本章程的规定、或因其在履行职务中发生的错误、疏忽或懈怠而对公司造成损害，向其提起责任之诉；由合伙人、股东大会或股东决定提起该诉讼并指定代表公司进行诉讼者。若公司处于清算阶段，则由清算人提起诉讼。若依照破产法对公司启动任一清算程序，则由依法代表公司者提起该诉讼。\n代表公司资本（百分之五）的一名或多名合伙人或股东（公司设立合同或基本章程规定更低比例的除外），可以在公司未提起时提起为公司确定的责任之诉，但须注意：提起诉讼的基本目的是实现公司利益、诉讼建立在正当基础之上、起诉人为善意、且在提起诉讼时为公司合伙人或股东。\n提起本条第（二）款所述诉讼，以在提起诉讼之日前至少（十四）日将提起诉讼的意图通知公司经理或其董事会成员（视情形而定）为条件。\n若经理或董事会成员所发生的错误对合伙人或股东造成特别损害，则该合伙人或股东可以对其提起个人诉讼。",
   "remediated_chinese_text_hash_sha256": "3f2823b09414a68c38bcb4b52ccf82c3b9850ef41957eff54d2d67a6b781180c",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_arabic_plus_existing_chinese_candidate",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "condensed_candidate_needs_expansion",
