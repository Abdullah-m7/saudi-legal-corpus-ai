  {
   "article_number": 252,
   "bab": 12,
   "article_title_ar": "صلاحيات المصفي",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "f5100ba41a9216c0374ae14a53d89baf4de2e86d80496821a38bd511c67ece2e",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "2ce0ca57f4dea610e7572e3ac02b8e63662ed62d19dc3c18679a56686118a9e9",
   "prior_candidate_record_id": "zh-int-companies-art-252",
   "prior_candidate_hash_sha256": "13c0b46a142a9c9581896cb6bf5715e1103c69a24fe9e8678d8310a0d60321ef",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在遵守任命清算人决议所载限制的前提下，清算人在司法机关、仲裁机构和第三人面前代表公司，并进行清算所需的一切行为，特别是将公司资产变现，包括以拍卖或任何其他能确保取得最佳可能价格的方式出售动产或不动产。\n若任命清算人的机关授权，清算人可以将公司资产整体出售、或作为出资投入另一公司。\n清算人不得开展新业务，但为完成先前业务所必需者除外。\n公司受清算人在其权限范围内所进行行为的约束。\n清算人的权限因清算工作结束、或清算期届满（以较早者为准）而终止，但依照本法规定延长的除外。",
   "remediated_chinese_text_hash_sha256": "9258b655cb1ef45f1e2ab8dbc647608159cdf0dae7c94ae907d6d5028951b8f7",
   "internal_reference_only": true,
