  {
   "article_number": 264,
   "bab": 13,
   "article_title_ar": "الجزاءات البديلة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "55a54c903b7d0f5b9de32b577d994fa34a952b1160ca4b18eff0a71b43d1a478",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "b6d903bcfb143c1c7af0ef5e8d1ead780b5b92071b4aff468ad7bed56218df46",
   "prior_candidate_record_id": "zh-int-companies-art-264",
   "prior_candidate_hash_sha256": "e9f3a1f7e7d76b915b94b6beca4ebb0e8e52ce6498200b95941050305fd5dbb1",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "主管司法机关除本法第（二百六十）条和第（二百六十一）条所定处罚之外、或代替之，可以采取下列任一措施：\n（甲）对有关人员予以警告。\n（乙）责令有关人员采取避免犯罪发生的必要步骤、或采取处理其影响所需的纠正步骤。\n（丙）责令有关人员停止或不为诉讼所涉的行为。\n（丁）禁止其担任在资本市场上市的股份公司董事会成员。\n就违规行为，主管机关除本法第（二百六十二）条所定处罚之外、或代替之，可以采取本条第（一/甲）项和第（一/乙）项所述任一措施。",
   "remediated_chinese_text_hash_sha256": "a852249dfc903ca3af4527e90384672f3c6ff428355e8c0aed90d5ea48e7d1d2",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
