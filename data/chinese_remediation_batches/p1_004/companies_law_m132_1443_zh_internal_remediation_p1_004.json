   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 255,
   "bab": 12,
   "article_title_ar": "سداد الديون",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "9fd7bb28ad71b088c51da66ff519a52cfe5149b205318eea0e6ae9997cc157e3",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "de85a2b170132c3c3c7d522525731d90b95886be17331c10c959919ba113ac2c",
   "prior_candidate_record_id": "zh-int-companies-art-255",
   "prior_candidate_hash_sha256": "595ad651911d6f1ab9acbeba670688ec3e698b95dabfd2ba4e08fec099177e80",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "清算人应按优先顺序偿付公司已到期的债务，并就未到期或有争议的债务预留所需款项。\n因清算而产生的债务较其他债务享有优先权。\n清算人在偿付债务后，应向合伙人或股东返还其在资本中份额或股份的价值，其后依照公司设立合同或基本章程的规定向其分配剩余款项。若设立合同或基本章程未就此事项作出规定，则按合伙人或股东在资本中份额或股份的比例向其分配剩余款项。\n若公司净资产不足以支付合伙人份额或股东股份的价值，则按分配亏损所定比例在其间分配亏损。",
   "remediated_chinese_text_hash_sha256": "e49977aaa30c0fc3de82510e4f9e58f839fdc6a7cc19b86240ad18dc01e02389",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
