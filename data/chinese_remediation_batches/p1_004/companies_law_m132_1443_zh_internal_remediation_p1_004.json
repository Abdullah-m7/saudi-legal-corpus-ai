  {
   "article_number": 253,
   "bab": 12,
   "article_title_ar": "جرد الأصول والالتزامات",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "dd131c7bda25f42293651c0a2c8b4d380dd2e56fb4bdaa69c9cc9ff4ae59a7f6",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "f2a08c30bdb51db2924c48b0ee7659ac3a8275f2c09e2d160d466e52423be95e",
   "prior_candidate_record_id": "zh-int-companies-art-253",
   "prior_candidate_hash_sha256": "ff2fad97b023c3ca18aac0569396924ed326aadbd2b59ce4ca9474a9df93d1a3",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司经理或其董事会成员应在清算人受任时，向其提交公司的记录、文件以及其所要求的说明和资料。\n清算人应在其开始工作之日起（九十）日内，对公司的全部资产及其权利和义务进行清点，并要求公司审计师（如有）就该清点出具报告。任命清算人的机关可以在必要时延长此期限。\n清算人应在每一财政年度末编制财务报表和关于清算工作的报告，其中载明其对清算工作的意见和保留、导致其受阻或延迟的原因（如有）以及其延长清算期的建议。清算人应向商业登记机关提供该等文件的副本，并依照公司设立合同或基本章程的规定提交合伙人、股东大会或股东批准。",
   "remediated_chinese_text_hash_sha256": "76342beea9e47c145363ba8daf0bbd66c985eaf157263803b76edf8ae39ddeec",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
