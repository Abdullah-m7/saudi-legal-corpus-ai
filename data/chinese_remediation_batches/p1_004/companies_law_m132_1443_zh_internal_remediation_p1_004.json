   "english_guidance_hash_sha256": "6fce80a7523f7292abd339fa6da92ddab77b6fa8f1005baf4065521cd7fff289",
   "prior_candidate_record_id": "zh-int-companies-art-233",
   "prior_candidate_hash_sha256": "01cf3de2f8f650b34e0f9a3b5983620330d9e53ca56ed8ed1e2610d03fdc7f7a",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "因分立而新设的公司，在依照分立决议归于其的范围内，为被分立公司的继受人。但是，被分立公司的债权人可以向因分立而新设的两家或多家公司请求偿付被分立公司所负的债务和义务，该两家或多家公司对偿付该等债务和义务负连带责任；但与债权人约定将其请求权利转移给因分立而承受该等债务和义务的新设公司的情形除外。",
   "remediated_chinese_text_hash_sha256": "26a9805e7d497a46f8909d1dc0a1b5f5460d43d9e8bee408656ba8a3c99954b3",
   "internal_reference_only": true,
