   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 256,
   "bab": 12,
   "article_title_ar": "التصرف في أموال الشركة غير الربحية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "5d3d5e31b6a25cd61a98e0aff083d8277869ad85fe72426459b3c3beaf870c1f",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "102ba388d6a4b7831b675d52d084075d8559b501d391167cf579b672c20eca38",
   "prior_candidate_record_id": "zh-int-companies-art-256",
   "prior_candidate_hash_sha256": "1833be74bb0d14d4ff47fbb9cd58dac390b24a22bb8642d53599303f2761fdae",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "非营利公司清算时，其净资产归于该非营利公司设立合同或基本章程所确定的非营利人员或实体。\n若非营利公司的净资产系产生于捐赠、遗嘱或瓦克夫（宗教捐赠），则其归于捐赠人、遗嘱人或瓦克夫设立人所确定的非营利人员或实体。\n若公司设立合同或基本章程未确定其财产所归属的非营利人员或实体、且捐赠人、遗嘱人或瓦克夫设立人亦未确定，则该财产在取得部的同意后，归于以实现与该等财产所定途径和领域相同或相似途径和领域为目的的非营利人员或实体。\n承受该财产的非营利人员或实体，有义务将其用于为其所确定的途径和领域。",
   "remediated_chinese_text_hash_sha256": "a853c12e66888e7506927e7c3a7fac5058e94302cbd673ec6bb4b5b7532c265a",
   "internal_reference_only": true,
