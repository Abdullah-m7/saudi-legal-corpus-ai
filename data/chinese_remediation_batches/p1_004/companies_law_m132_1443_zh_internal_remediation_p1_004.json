  {
   "article_number": 271,
   "bab": 13,
   "article_title_ar": "الاطلاع على سجلات الشركة ووثائقها",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "e115f64acc01348543013c4409930f2ddff77292fddbfcd6f6fd23b7fe55fd59",
