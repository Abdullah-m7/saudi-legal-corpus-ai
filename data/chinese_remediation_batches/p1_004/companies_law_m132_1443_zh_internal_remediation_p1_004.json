  {
   "article_number": 242,
   "bab": 12,
   "article_title_ar": "فحص المركز المالي للشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "6bf48b04282d98ea7a5abde26ef39c02d3e128c6cea833024cb32cd2721e321d",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "984b8bfc5a54d37a942608a40c6f8464b85013413d92acf15ef30f5da5c29098",
   "prior_candidate_record_id": "zh-int-companies-art-242",
   "prior_candidate_hash_sha256": "a08059fdcd80201e78c8574be567182ef859097f536df90611697cde8adfee82",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在合伙人、股东大会或股东作出解散公司的决议前，公司经理或其董事会成员有义务编制一份说明，表明其已审查公司状况，并载明确认公司资产足以在拟议清算期结束时偿付其债务、且公司未依照破产法陷入财务困境。该说明应在其编制之日起（三十）日内提交合伙人、股东大会或股东，以作出解散公司的决议。\n若本条第（一）款所述说明表明公司资产不足以偿付其债务、或公司依照破产法陷入财务困境，则合伙人、股东大会或股东不得作出解散公司的决议，否则其对公司剩余的任何债务负连带责任。",
   "remediated_chinese_text_hash_sha256": "44e5810a3dddd898a611d6578fde1248016309b59fdba4610ad04c2b76a4259c",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
