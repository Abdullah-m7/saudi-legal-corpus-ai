   "bab": 10,
   "article_title_ar": "ديون الشركة محل التقسيم والتزاماتها",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "613b0aad93512a8554f5839521c98bc601350ca1f2ae891734814c270c174569",
