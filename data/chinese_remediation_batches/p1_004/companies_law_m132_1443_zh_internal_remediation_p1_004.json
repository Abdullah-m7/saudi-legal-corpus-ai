  {
   "article_number": 266,
   "bab": 13,
   "article_title_ar": "الجهة القضائية المختصة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "777e134bf2b2260a2fe940deab8f692088be96d8366671b1f61866726542efcd",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "211f33dde4aa23723b0f965e06877ab5b8404a66d9fb6ce1284ba0bdc2fe9464",
   "prior_candidate_record_id": "zh-int-companies-art-266",
   "prior_candidate_hash_sha256": "f62a1260c190ef7c5708b2776222fa87533ae8f2ddb33c6b909ddfb37ca0904d",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "主管法院负责审理和裁决因适用本法及实施条例而产生的一切民事、刑事诉讼和纠纷，并负责科处违反其规定所定的处罚，但与在资本市场上市的股份公司相关者除外。\n证券纠纷裁决委员会负责审理和裁决对管理局决定的申诉、以及因适用本法及实施条例而产生的一切民事、刑事诉讼和纠纷，并负责科处违反其规定所定的处罚，此系就在资本市场上市的股份公司相关者而言。该委员会就其依照本法所主管的诉讼，适用其依照资本市场法应遵循的规则和程序。",
   "remediated_chinese_text_hash_sha256": "72b015684eaef547efff40636748d77aecc63cd09a435546e5b3d62e9f89cda6",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 267,
   "bab": 13,
   "article_title_ar": "لجنة النظر في المخالفات",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "f7d8d3f0c2fadc5f7fac4200d0f83bf851ea7abad1d91073a365269c89ae661f",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "946fecc803e102d5681255a450bfb68cc8662040901fa4ef56ca39fd61dce5cd",
   "prior_candidate_record_id": "zh-int-companies-art-267",
   "prior_candidate_hash_sha256": "9b25852a2a32aab0b26348d33668e77bb540febba93ead1cc6a78216efe93cbf",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "由部长决定在部内组成一个委员会，成员不少于三人，由具备法律资格者担任主席，负责审查本法第（二百六十二）条所规定的违规行为并就其科处处罚，但与在资本市场上市的股份公司相关的违规行为除外。部长可以确定无需提交该委员会即可直接科处处罚的违规行为。被科处处罚决定者有权在依照实施条例确定的送达方式通知之日起（三十）日内向主管法院申诉。该委员会的工作规则、及其主席、成员和秘书处的报酬，由部长决定。\n管理局理事会负责就本法第（二百六十二）条所规定、与在资本市场上市股份公司相关的违规行为科处所定处罚；被管理局理事会作出决定者有权依照资本市场法向证券纠纷裁决委员会申诉。",
   "remediated_chinese_text_hash_sha256": "a68119a1284fdfae9e9198a6c73739190eca15003962afb888c77cd46a1b7774",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
