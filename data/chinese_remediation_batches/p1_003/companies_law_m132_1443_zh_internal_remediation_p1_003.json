  {
   "article_number": 170,
   "bab": 6,
   "article_title_ar": "الاعتراض على قرار الجمعية العامة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "21b4d4204dc90b86c6faecb13c628ef39a2e02b7fc0531d5f4703209c6302811",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "9c8478be8a28b64aba271d9092d2dc9e90b974ea8e1c2b3bef367ef6d6d87107",
   "prior_candidate_record_id": "zh-int-companies-art-170",
   "prior_candidate_hash_sha256": "2969224563108cb63f1a17a54e2547efd09f3e3bc207c368c73328ffe874b57e",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在不影响善意第三人权利的前提下，每一合伙人均有权就合伙人股东大会违反本法或公司设立合同规定作出的决议，向主管司法机关请求撤销。但是，只有以书面方式对该决议提出反对的合伙人、或在知悉该决议后未能对其提出反对的合伙人，方可请求撤销该决议；撤销一经确定，该决议对全体合伙人视为自始不存在。\n撤销之诉自本条第（一）款所述决议作出之日起满（九十）日后不予受理。\n提起本条第（一）款所述诉讼，以起诉人在起诉时及诉讼全部程序期间均为公司合伙人为条件。",
   "remediated_chinese_text_hash_sha256": "252d1794284363c7fa94083fdabcedbf0bf348654f09a40f71e8e39f38dc1fe3",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
