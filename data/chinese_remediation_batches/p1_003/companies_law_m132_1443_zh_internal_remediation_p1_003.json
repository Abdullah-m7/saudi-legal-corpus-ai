  {
   "article_number": 185,
   "bab": 7,
   "article_title_ar": "تعريف الشركة غير الربحية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "7d39f78fe2c0ff58e82b67bf82fad188ebaa1d0ec1e7f9c2613b0fb26bc0cbd1",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "9f5d67ddc312670a6c064e3545d5d5df6f45baedebaa1ab248d6c239371cd06c",
   "prior_candidate_record_id": "zh-int-companies-art-185",
   "prior_candidate_hash_sha256": "4dca2fc89fd53170edd1d9fefcd083fdfd144139791ac30ea2fc2ab714b84fdf",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公众非营利公司：是采取股份公司形式、且不得采取任何其他形式的公司，其经营活动所实现的利润用于专门旨在服务社会公众的各类非营利公用途径和领域。上述途径和领域由部与非营利部门发展国家中心协调确定。\n私人非营利公司：是采取有限责任公司、股份公司或简易股份公司形式、且不得采取任何其他形式的公司，其经营活动所实现的利润用于各类非营利途径和领域。\n禁止非营利公司公开发行其股份进行认购。\n非营利公司凡本编无规定者，在不与其性质相抵触的范围内，适用其所采取公司形式的专门规定。",
   "remediated_chinese_text_hash_sha256": "6c94b522c8c435cceeeea041438f70ebfe97ea33b67645b7de92d1e5fc0e369b",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
