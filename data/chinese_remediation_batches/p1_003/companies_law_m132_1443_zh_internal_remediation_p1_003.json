  {
   "article_number": 166,
   "bab": 6,
   "article_title_ar": "إصدار قرارات الشركاء",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2544b70779cac352fad492b17c722400a43f49781482f70bab35ec3f8f06fe3b",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "3a3269b7598feba7cbd57fd87170d19db0e3818c60b0f37a4a488356748f65e4",
   "prior_candidate_record_id": "zh-int-companies-art-166",
   "prior_candidate_hash_sha256": "d41c5a67a9a938d62a0cad711eb2eda452974f7c7d20acbaa1fb978d40b68606",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "合伙人的决议在股东大会上作出。但是，合伙人决议也可以通过传阅方式提交其作出，而无需召开股东大会；在此情形下，公司经理将拟议决议及与之相关的文件发送给每一合伙人，由合伙人以书面方式对其表决。\n除公司设立合同规定其他通知方式外，拟议决议及与之相关的文件可以通过下列任一方式发送：\n（一）以挂号信发送给合伙人。\n（二）亲自送交合伙人或其依法定代理人。\n（三）通过电子邮件或任何现代技术手段发送。\n在任何情形下，决议均须经代表至少超过（半数）资本的一名或多名合伙人同意方为有效，公司设立合同规定更高多数的除外。\n若在第一次审议或磋商中未达到本条第（三）款所规定的多数，则应召集合伙人开会；在此情形下，决议由出席会议所代表份额的多数同意作出，无论其在资本中所占比例如何，公司设立合同另有规定的除外。\n公司设立合同可以规定召集会议或通知决议的任何其他方式。",
   "remediated_chinese_text_hash_sha256": "f01d34788ba55249feffba228fd3bde8d90d65d66017acc335854c6d402d0ff4",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
