   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 212,
   "bab": 8,
   "article_title_ar": "وفاة الشريك أو المساهم",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "c7ff05ef571f6727e4a2d73b0446a31fd6c5f850476c9eebe53a1ef730272980",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "ab93524da5727b14b9b65325e54610cf31c3eb0d342c80c0a209536439003edf",
   "prior_candidate_record_id": "zh-int-companies-art-212",
   "prior_candidate_hash_sha256": "46042dd85a1f53e183d424ec9ac6c67323451a81190b186ced37510141989b1c",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "若专业有限责任公司的某一合伙人、或专业股份公司或专业简易股份公司的某一股东死亡，则除公司设立合同或其基本章程另有规定外，其份额或股份（视情形而定）归于其继承人。\n若专业无限公司的某一合伙人死亡，公司在其他合伙人之间继续存续，其份额归于其继承人；死亡合伙人份额的价值由一名或多名经认可的评估师估定，其编制报告说明在合伙人死亡之日每一合伙人在公司财产中份额的公允价值。继承人对此后新产生者不享有份额，但该等权利系产生于其被继承人死亡之前的业务者除外。\n专业无限公司的设立合同、或死亡合伙人的继承人与公司其他合伙人之间的专门协议，可以规定死亡合伙人的继承人通过将公司转为两合公司、股份公司、简易股份公司或有限责任公司，取代其被继承人成为公司合伙人。在公司转为两合公司的情形下，继承人具有有限合伙人（受托合伙人）的身份。\n若专业两合公司的某一合伙人死亡，除公司设立合同另有规定外，其份额归于其继承人。继承人在参加公司的情形下具有有限合伙人（受托合伙人）的身份。",
   "remediated_chinese_text_hash_sha256": "4a5c5d8e35514784f19f87d7c185045aa57f2b11d489e72e6ccccb8c5cb7751a",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
