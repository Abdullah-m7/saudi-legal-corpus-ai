  {
   "article_number": 225,
   "bab": 10,
   "article_title_ar": "مقترح الاندماج",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "2e18653c06eabd99ee0372bbe40e1f0d6a81b8c7d33a566926bcd809ed4b363c",
