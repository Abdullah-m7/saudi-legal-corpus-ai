  {
   "article_number": 222,
   "bab": 10,
   "article_title_ar": "الاعتراض على قرار التحول",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "1ef1e0dce039b4f1f16899f92a8603477e7831d3301488eaf013c909d4a4e725",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "0e7aa0ade0cada5c752f67d8a889608064c49e457f5e585653890a490542361d",
   "prior_candidate_record_id": "zh-int-companies-art-222",
   "prior_candidate_hash_sha256": "69747b60c94d296d9fcd16be367526b5eef291ed35ff9467db3f2de73ed9f930",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在不影响按公司形式所确定的份额或股份转让规定的前提下，对转型决议提出异议的合伙人或股东，可以根据在决议作出之日起（十五）日内向公司提交的书面请求退出公司。在此情形下，除公司设立合同或其基本章程另有规定外，其份额或股份价款的支付，按约定价值、或按一名或多名经认可评估师编制的、说明其份额或股份在转型之日公允价值估定的报告支付。异议人在发生分歧时可以诉诸主管司法机关。",
   "remediated_chinese_text_hash_sha256": "91bf5e82256f22dcc1fa9bdc93fe4fc824ba843e4e73f1dbdd40cc992baaf861",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
