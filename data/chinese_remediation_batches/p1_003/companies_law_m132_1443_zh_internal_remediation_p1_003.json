  {
   "article_number": 200,
   "bab": 8,
   "article_title_ar": "تأسيس الشركة المهنية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "aaa9b729aefb6009625a4848606297b5daf344f7a4bf1ab5dce46402aa57883e",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "5f7c15fbad1f9b42a779908cc9fa58d02c4507596180588de9ec0ecb78126875",
   "prior_candidate_record_id": "zh-int-companies-art-200",
   "prior_candidate_hash_sha256": "ad71a1832196e2118e6996a22c52f0ae42242cc6677c23906c01c1370791f3e6",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "获准执业某一自由职业的人，可以在其相互之间以本法第（四）条所列任何形式设立专业公司。\n获准执业某一自由职业的人，可以设立专业股份公司、简易股份公司或一人有限责任公司，通过其执业其职业。若其获准执业不止一种自由职业，则可以在满足实施条例所定条件和规则后，通过公司执业其全部或部分职业。\n可以由获准执业不止一种自由职业的人设立专业公司；亦可以在获准执业一种或多种自由职业的人与非沙特专业公司之间，设立参股专业公司。实施条例说明设立此类公司的专门条件及规范其活动的规则。\n专业公司中——除以无限合伙人身份参加的无限公司和两合公司外——可以由非获准执业其经营的一种或多种自由职业的自然人、或法人参加或入股。实施条例说明与此相关的条件和规则，以及管理此类专业公司的一般规则，以保障专业合伙人或股东在执业其职业方面的独立性。",
   "remediated_chinese_text_hash_sha256": "d317020b2a7696ce91e75dfe2aec888e95fd7ed7ac8d97ce2670f882532fe1a6",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
