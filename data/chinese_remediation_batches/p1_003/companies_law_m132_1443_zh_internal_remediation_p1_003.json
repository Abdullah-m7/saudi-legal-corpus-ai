  },
  {
   "article_number": 178,
   "bab": 6,
   "article_title_ar": "التنازل عن الحصص",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "60fd8b03539a23f1d03b22cf786fb15ea9118d28130d59eedcf5230b4cf66bfa",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "95efa8ed21cc761ef728ed9935813b38fc64bcaa57196301ad3f89e064f86026",
   "prior_candidate_record_id": "zh-int-companies-art-178",
   "prior_candidate_hash_sha256": "bdb05d2e0bad7fb1bf9892ba69a5cbd4c5cc9a0e780ca0ed2085fa833942e5de",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "合伙人可以依照公司设立合同规定的条件，将其份额转让给任何合伙人。\n合伙人若欲将其份额有偿或无偿转让给公司合伙人以外的人，应通过公司经理将受让人或买受人的姓名及转让或出售的条件通知其他合伙人；经理应在通知送达后立即通知其他合伙人。每一合伙人均可请求赎回该份额并支付其价款、或由公司在经理被告知约定价款之日起（三十）日内购买该份额。若不止一名合伙人请求赎回该份额，则按各自在资本中所占份额的比例在其间分配。在对份额价值发生分歧时，由请求赎回人或公司（视情形而定）出资，委托一名或多名经认可的评估师估价，其编制报告说明欲转让合伙人份额的公允价值。若行使赎回权的期限届满而无任何合伙人请求赎回该份额，或请求赎回人未支付其价款，或公司未在该期限内购买该份额，则份额所有人有权将其转让给第三人。\n公司设立合同可以规定关于份额转让通知的其他程序、或其他估价方法、或行使赎回权并支付价款、或公司购买份额的更长期限。\n本条所规定的赎回权，不适用于因继承、遗嘱或主管司法机关判决而发生的份额所有权转移。",
   "remediated_chinese_text_hash_sha256": "45a550f616799092ee510cda8dc145da7c7f5e425ba054f7a483e591eed07f63",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
