   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 201,
   "bab": 8,
   "article_title_ar": "المشاركة في أكثر من شركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "73cc7c3c20dffc6b39ed240f7471c5c3f1a866204da42d79994cb4cec1e854a7",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "2eef081ee6ef8f8b4d091052a4e389236f2beeabf0a64aa3937d22fb209b22a6",
   "prior_candidate_record_id": "zh-int-companies-art-201",
   "prior_candidate_hash_sha256": "eeb767130714985002b36d68017de3477dce744d24b3b61deb0b1c94f13fcfdf",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "除公司设立合同或其基本章程有规定外，并在不违反相关法规的前提下，专业公司中执业自由职业的合伙人或股东，不得参加或入股经营同一自由职业的另一专业公司。实施条例说明获准执业的合伙人或股东可以参加或入股另一专业公司的规定和规则。",
   "remediated_chinese_text_hash_sha256": "4650f688818062b8a4421d0cfa9813fc2ac7f19125b9080f309cfb57a534849a",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
