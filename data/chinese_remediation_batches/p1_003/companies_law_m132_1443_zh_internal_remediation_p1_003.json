  {
   "article_number": 221,
   "bab": 10,
   "article_title_ar": "تحول الشركة غير الربحية",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "7c8a3ca0c530a1e124602399650d76d955fffef36d8cbfb7211b4ec67f914355",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "6a23a7de206b93c8f95aacad092b41d24e8d92a8aa72e5147a7a2e02b0983877",
   "prior_candidate_record_id": "zh-int-companies-art-221",
   "prior_candidate_hash_sha256": "82351525d3efea3f3513ee4f12dc01559773ad8b6dc69ec60a3cdbf646798925",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "在遵守本法第（二百二十）条第（一）款规定的前提下，除公司设立合同或其基本章程另有规定外，私人非营利公司（不含公众非营利公司）可以转为任何形式的公司，但须将设立时资本以外增加的利润、储备、捐赠或其他款项，用于其设立合同或基本章程所规定的非营利途径和领域，并退还其所获得的任何豁免。实施条例确定其相关规定。\n任何公司经合伙人或股东一致同意，可以转为公众或私人非营利公司。",
   "remediated_chinese_text_hash_sha256": "fa0fdee40a84bdd8b3eab44c168f431be3250ff6813bedf58183d03a21efeb4a",
   "internal_reference_only": true,
