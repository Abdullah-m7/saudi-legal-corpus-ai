   "english_guidance_hash_sha256": "ee7413308eee14c9434d625be1b463f9dc3266ecf95bce8e1e793c954663f723",
   "prior_candidate_record_id": "zh-int-companies-art-225",
   "prior_candidate_hash_sha256": "d9519a2da3caee2274fdae7e7d5dd3db860655d3f5f01cd870ffde2bdc1ebc53",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "合并系指将一家或多家公司并入另一家现存公司，或将两家或多家公司融合以设立一家新公司。\n合并提案应按各当事公司修改其设立合同或基本章程所确定的程序获得其批准；合并提案确定其条件，并说明对价的性质和价值，包括被合并公司在合并公司或因合并而新设公司资本中所占份额或股份的数量，以及关于各合并当事公司偿付其债务能力的说明。\n在遵守相关法规规定的前提下，公司即使依照本法规定处于清算阶段，亦可以并入另一相同形式或其他形式的公司。\n合并只有在对各当事公司资产进行评估后方为有效。\n合并的对价为合并公司或因合并而新设公司中的份额或股份。\n主管机关可以确定执行本条规定的规则和程序，包括为购买份额或股份的零数、或补偿对合并决议提出异议的合伙人或股东的现金对价，以及合伙人或股东在其具有不同于其作为公司合伙人或股东利益的利益时的表决规则。",
   "remediated_chinese_text_hash_sha256": "2d8bfd0395bc8e7872f2ba064dd6688f97ca54a8dcb488d5dd16a3f0964810d4",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
