  {
   "article_number": 183,
   "bab": 6,
   "article_title_ar": "مدّ أجل الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "c19827c45cfdf413105a451296388240d305dea61dfb2c476ecdef321bdb9233",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "10101a6ecf5371e1a3068aa67c0759375de33df1ef115b24c3c8748357fc1cf1",
   "prior_candidate_record_id": "zh-int-companies-art-183",
   "prior_candidate_hash_sha256": "03213a84ae720c40f83096186525d9160bd20cf49618644b3ebd9ff5525b2981",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "定有期限的公司，可以在其期限届满前，由合伙人股东大会以持有代表资本份额半数的任意数量合伙人作出的决议延长另一期限，公司设立合同规定更高多数的除外。\n若未作出延长公司期限的决议而公司继续经营其业务，则公司期限按其设立合同所载相同条件延长一个相同期限。\n不愿继续留在公司的合伙人可以退出公司，其份额依照本法第（一百七十八）条的规定估价；除退出的合伙人与其他合伙人另有约定外，延长在该合伙人的份额出售给合伙人或第三人（视情形而定）并向其支付价款后方可生效。\n对不延长期限具有利害关系的第三人，可以对延长提出异议并主张其对己不生效。",
   "remediated_chinese_text_hash_sha256": "bc1d1c3b548996a611457afeacf9d0a4cbf984c4b8dde9decb8c69a193146a0c",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
