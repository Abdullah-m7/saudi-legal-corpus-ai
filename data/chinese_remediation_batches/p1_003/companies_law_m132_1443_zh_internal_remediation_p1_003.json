   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 172,
   "bab": 6,
   "article_title_ar": "تعديل عقد تأسيس الشركة",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "1426e1c04b93953ae1c49d98ce62e2d4d412d25c83342ab6cfc418297a230289",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "5ecaf84ea9ab4049a653562c468c8ad2d168688f5f036eeab4c733a795e42752",
   "prior_candidate_record_id": "zh-int-companies-art-172",
   "prior_candidate_hash_sha256": "54389bacd93739fe69b479b07fe0b75cc27c05c8edf6e3351b8126b1229e0365",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "公司设立合同的修改，包括增加或减少其资本，须经代表至少（四分之三）资本的一名或多名合伙人同意，设立合同规定更高比例的除外。\n在同意通过发行新份额增加公司资本时，合伙人按其在公司资本中所占比例，对以现金份额发行的份额享有优先认购权，具体依照实施条例的规定。\n不得通过提高合伙人份额的名义价值、或中止优先权的行使来增加资本，但经合伙人一致同意的除外。",
   "remediated_chinese_text_hash_sha256": "afa571f81fc54c4c3071425474ef20e80b44dc1898c1af5924902355cf0fe744",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 174,
   "bab": 6,
   "article_title_ar": "مقدار رأس المال",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "ac42aed55239876790c395061cedc2a4f949ee38305ec9d5226fc80ee9977d53",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "45964661eebc786ead30f85235d572cbf0c19252010912e92981e7fe3b148788",
   "prior_candidate_record_id": "zh-int-companies-art-174",
   "prior_candidate_hash_sha256": "ea5da1e426fa585f5348e73fa178de0ea2c3b396a2f5aace7f1b0c8261c2fdd1",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "合伙人在公司设立合同中确定公司资本额，资本分为价值相等的份额，份额不可分割、不可流通。若份额由多人共有，公司可以中止行使与该份额相关的权利，直至份额共有人从其中推选出一人在公司面前视为该份额的单独所有人。公司可以为此项推选确定期限，逾期未推选的，公司可以在期限届满后为份额共有人的利益出售该份额；在此情形下，除公司设立合同另有规定外，该份额应依照本法第（一百七十八）条的规定，先向其他合伙人、再向第三人出售。",
   "remediated_chinese_text_hash_sha256": "85527b2638e085ef8a5003528b32e0a0a3eb3721bf19ce0258c13d9be9beea02",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
   "translation_basis": "official_arabic_governing_text",
   "english_guidance_role": "secondary_guidance_only",
   "source_status_before": "isolable_candidate_materially_incomplete_or_condensed",
   "remediation_action": "retranslate_internal_chinese_from_arabic",
   "qa_status": "pending_future_qa"
  },
  {
   "article_number": 176,
   "bab": 6,
   "article_title_ar": "تخفيض رأس المال",
   "arabic_source_file": "data/official_arabic_legal_llm/companies_law_m132_1443_official_arabic_legal_llm_001_281.json",
   "arabic_source_hash_sha256": "e82270900fa3d30e5d0b70cb23e877cb896e8492a68b617d07d065c45691e24a",
   "english_guidance_file": "data/official_english_legal_llm/companies_law_m132_1443_official_english_legal_llm_001_281.json",
   "english_guidance_hash_sha256": "b829b3524824a5270959193553cc3c55638c16c7c6f6baec064ca978166b4ef8",
   "prior_candidate_record_id": "zh-int-companies-art-176",
   "prior_candidate_hash_sha256": "63815b3044634e51ef764bc23bd2d4a4e77f79cc78af618cd841e2d62fd6ea14",
   "qa_priority": "P1",
   "qa_recommended_action": "retranslate_from_arabic_before_full_chinese_layer",
   "remediated_chinese_text": "合伙人股东大会可以在资本超过公司需要、或公司发生亏损时，决议减少资本。在后一情形下，减资决议只有在合伙人股东大会上宣读由公司经理编制的、关于减资理由、公司义务及减资对履行该等义务影响的说明后方可作出，该说明并附具公司审计师的报告。在合伙人以传阅方式作出决议的情形下，可以仅将上述说明提交合伙人。\n若减资系因资本超过公司需要，则公司每一经理应编制关于公司财务清偿能力的说明，其中包含下列内容：\n（一）经其审查公司在说明编制之日的状况，确认不存在任何将使公司无法偿付其债务和义务的情形。\n（二）公司有能力偿付其在说明编制之日后（十二）个月内到期的债务和义务。\n公司每一经理应在本条第（二）款所述说明上签字并载明其编制日期，并至少在确定作出减资决议之日前（十五）日将其提供给合伙人。\n合伙人应自减资决议作出之日起（十五）日内，向商业登记机关提交载有减少公司资本的公司设立合同修改草案，并按情形附具本条第（一）款和第（二）款所述文件。减资决议在商业登记机关登记和公告后生效。",
   "remediated_chinese_text_hash_sha256": "7244bf84f4ba9213aef01f3f016c8c13e9dd4f4ea00e1736ed6b67cd290a862d",
   "internal_reference_only": true,
   "official_chinese_translation_claimed": false,
   "chinese_binding_claimed": false,
   "chinese_governing_claimed": false,
   "source_basis": "official_source_based",
   "repository_legal_review_status": "repository_owner_review_active",
   "external_legal_review_status": "not_performed",
