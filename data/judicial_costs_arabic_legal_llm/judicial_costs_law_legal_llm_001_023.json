  {
   "law_id": "sa-judicial-costs-law-m16-1443",
   "law_component": "law",
   "article_number": 16,
   "is_mukarrar": false,
   "article_key": "judicial_costs_art_016",
   "article_title_ar": "المادة السادسة عشرة",
   "section_ar": "المادة السادسة عشرة",
   "legal_status_ar": "اصلية",
   "is_repealed": false,
   "is_amended": false,
   "is_added": false,
   "record_id": "judicial-costs-law-llm-art-016",
   "record_type": "verified_arabic_article",
   "language": "ar",
   "governing_text_language": "ar",
   "article_text_ar": "تُرد التكاليف القضائية المدفوعة متى تبين عدم وجوبها على دافعها أو استفادته من حالة من حالات الإعفاء ومن ذلك مايأتي:\n١.إذا حكم لمصلحة دافع التكاليف القضائية.\n٢.طلب رد القاضي أو القضاة إذا قبل طلب الرد.\n٣.طلب تصحيح الحكم أو تفسيره إذا قضي بإجابة الطلب.\n٤.طلب الاستئناف إذا حكم بنقض الحكم المستأنف كلياً، وإذا نقض الحكم جزئياً فيعفى بقدر ذلك الجزء، وطلب النقض إذا قضي فيه بإعادة القضية إلى المحكمة مصدرة الحكم المعترض عليه.\n٥.إذا ترك المدعي عليه دعواه قبل عقد الجلسة الأولى؛ وفقاً للإجراءات النظامية.\n٦.الدعاوى التي تنتهي بالصلح قبل رفع الجلسة الأولى.\n٧.الدعاوى المتعلقة بالحقوق الخاصة التي ترفع بالتبعية للقضايا الجزائية إذا انتهت بالصلح على أي حال كانت فيها الدعوى.\nوتحدد اللائحة الإجراءات والقواعد الخاصة بذلك.",
   "article_text_hash_sha256": "3f5fef6f95a779b74ee8e0fda370fb8d2447c45b3df2f2992eefb374d10115d3",
